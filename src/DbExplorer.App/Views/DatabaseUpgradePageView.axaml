<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbExplorer.App.ViewModels"
             x:Class="DbExplorer.App.Views.DatabaseUpgradePageView"
             x:DataType="vm:DatabaseUpgradeSettingsPage">
  <StackPanel Spacing="10" DataContext="{Binding Options}" x:DataType="vm:OptionsViewModel">
    <TextBlock Classes="section" Text="N2F DATABASE UPDATES" Margin="0" />

    <StackPanel Spacing="4">
      <Label Content="_dbupdate folder" Target="{Binding #PathBox}" Padding="0" FontWeight="SemiBold" />
      <TextBlock Classes="dim small" TextWrapping="Wrap"
                 Text="The dbupdate folder of the n2f repo (Web/Common/n2jWeb.Data/dbupdate). Leave it empty to switch the upgrade feature off. The folder is checked and kept when you leave the box or press Enter." />
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="PathBox" Text="{Binding DbUpdatePath}" Watermark="C:\repos\n2f\Web\Common\n2jWeb.Data\dbupdate"
               Classes.error="{Binding HasPathError}" />
      <Button x:Name="BrowseButton" Grid.Column="1" Content="Choose folder…" Margin="8,0,0,0" ToolTip.Tip="Pick the dbupdate folder" />
    </Grid>

    <!-- What the folder is: checking, not usable (and why), usable, or not set -->
    <Panel MinHeight="20">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsChecking}">
        <PathIcon Classes="spin" Data="{StaticResource IconRefresh}" Width="12" Height="12" Foreground="{DynamicResource DbxAccent}" />
        <TextBlock Classes="dim small" Text="Checking the folder…" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="fielderror" Text="{Binding PathError}" TextWrapping="Wrap" IsVisible="{Binding HasPathError}" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PathInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
        <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource DbxSuccess}" VerticalAlignment="Center" />
        <TextBlock Classes="small" Text="{Binding PathInfo}" Foreground="{DynamicResource DbxSuccessText}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="dim small" Text="{Binding FeatureHint}" TextWrapping="Wrap" IsVisible="{Binding ShowHint}" />
    </Panel>
  </StackPanel>
</UserControl>
