<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DbExplorer.App.Views.VirtualKeyDialog"
        Title="Define key"
        Width="500" SizeToContent="Height" MinWidth="400" MinHeight="360" MaxHeight="640"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource DbxWindowBg}" BorderBrush="{DynamicResource DbxBorder}"
            BorderThickness="0,1,0,0" Padding="20,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="OkButton" Content="Use this key" Classes="accent" IsDefault="True" MinWidth="104" HorizontalContentAlignment="Center" Click="OnOkClick" />
          <Button Content="Cancel" IsCancel="True" MinWidth="88" HorizontalContentAlignment="Center" Click="OnCancelClick" />
        </StackPanel>
        <TextBlock x:Name="Counter" Classes="dim" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="{DynamicResource DbxPanelHeaderBg}" BorderBrush="{DynamicResource DbxBorder}"
            BorderThickness="0,0,0,1" Padding="20,14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <PathIcon Data="{StaticResource IconKey}" Width="26" Height="26" Foreground="{DynamicResource DbxIconKey}" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Define a key" FontSize="17" FontWeight="SemiBold" />
          <TextBlock x:Name="Heading" Classes="dim" TextWrapping="Wrap" MaxWidth="400" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="banner warn" Padding="20,8">
      <Grid ColumnDefinitions="Auto,*">
        <PathIcon Classes="bi" Data="{StaticResource IconWarning}" VerticalAlignment="Top" Margin="0,1,8,0" />
        <TextBlock x:Name="WarningText" Grid.Column="1" TextWrapping="Wrap" FontSize="12" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{DynamicResource DbxContentBg}" Padding="20,12,20,6">
      <StackPanel Spacing="6">
        <TextBlock x:Name="ExcludedText" TextWrapping="Wrap" Classes="dim small" IsVisible="False" />
        <TextBlock x:Name="UniqueText" TextWrapping="Wrap" Classes="dim small" IsVisible="False"
                   Text="Columns marked “unique index” are part of a unique index of this table: they are the safest choice." />
        <CheckBox x:Name="AllColumns" Content="Use all columns" Click="OnAllColumnsClick" />
        <TextBlock Classes="faint small" TextWrapping="Wrap" Margin="26,-2,0,0"
                   Text="All the columns together identify a row. It works for any table but fails on duplicate rows, and the WHERE of each change gets long." />
      </StackPanel>
    </Border>

    <Border Background="{DynamicResource DbxContentBg}" Padding="20,0,20,16">
      <Border Classes="surface" Background="{DynamicResource DbxInputBg}">
        <ScrollViewer>
          <StackPanel x:Name="ColumnList" Margin="10,8" Spacing="2" />
        </ScrollViewer>
      </Border>
    </Border>
  </DockPanel>
</Window>
