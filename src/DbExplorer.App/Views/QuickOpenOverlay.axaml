<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbExplorer.App.ViewModels"
             xmlns:views="using:DbExplorer.App.Views"
             x:Class="DbExplorer.App.Views.QuickOpenOverlay"
             x:DataType="vm:QuickOpenViewModel"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="4,1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- the search box has no frame of its own: the card is the frame -->
    <Style Selector="TextBox.search">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="0,8" />
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement"><Setter Property="BorderThickness" Value="0" /></Style>
  </UserControl.Styles>

  <!-- Scrim: catches clicks outside the card (closes the overlay) -->
  <Border x:Name="Scrim" Background="{DynamicResource DbxScrim}">
    <Border x:Name="Card" Width="620" MaxHeight="480" VerticalAlignment="Top" HorizontalAlignment="Center"
            Margin="0,84,0,0" CornerRadius="{DynamicResource DbxCardRadius}" BorderThickness="1"
            Background="{DynamicResource DbxContentBg}" BorderBrush="{DynamicResource DbxBorder}"
            BoxShadow="{DynamicResource DbxCardShadow}">
      <DockPanel>
        <!-- what is being searched -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource DbxPanelHeaderBg}" CornerRadius="8,8,0,0" Padding="14,7">
          <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DbxTextDim}" />
        </Border>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,0,0,1" Padding="14,0">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconSearch}" Width="18" Height="18" Foreground="{DynamicResource DbxAccent}" Margin="0,0,10,0" />
            <TextBox x:Name="QueryBox" Grid.Column="1" Classes="search" Text="{Binding Query, Mode=TwoWay}" Watermark="Type to search…" />
          </Grid>
        </Border>
        <!-- keyboard hints -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource DbxToolbarBg}" BorderBrush="{DynamicResource DbxBorderSubtle}"
                BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="14,6">
          <Grid ColumnDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="kbd"><TextBlock Text="↑↓" /></Border>
              <TextBlock Classes="dim small" Text="navigate" VerticalAlignment="Center" />
              <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Enter" /></Border>
              <TextBlock Classes="dim small" Text="open" VerticalAlignment="Center" />
              <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Esc" /></Border>
              <TextBlock Classes="dim small" Text="close" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="dim small" Text="{Binding Notice}" TextWrapping="Wrap" TextAlignment="Right"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </Border>
        <ListBox x:Name="ResultList" Margin="0,4" Focusable="False" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:QuickOpenItem">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{Binding Icon, Converter={x:Static views:Icons.ByKey}}" Width="14" Height="14" Margin="0,0,10,0"
                          Foreground="{DynamicResource DbxIconTable}" />
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="faint small" Text="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
