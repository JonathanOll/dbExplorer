<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbExplorer.App.ViewModels"
             xmlns:views="using:DbExplorer.App.Views"
             x:Class="DbExplorer.App.Views.QuickOpenOverlay"
             x:DataType="vm:QuickOpenViewModel"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

  <UserControl.Styles>
    <!-- the rows are driven from the search box (arrows, Enter): they never take the keyboard focus themselves -->
    <Style Selector="ListBoxItem">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="6,1" />
    </Style>
  </UserControl.Styles>

  <!-- Scrim: catches clicks outside the card (closes the overlay) -->
  <Border x:Name="Scrim" Background="{DynamicResource DbxScrim}">
    <Border x:Name="Card" Width="640" MaxHeight="500" VerticalAlignment="Top" HorizontalAlignment="Center"
            Margin="0,84,0,0" CornerRadius="{DynamicResource DbxCardRadius}" BorderThickness="1"
            Background="{DynamicResource DbxSurface}" BorderBrush="{DynamicResource DbxBorder}"
            BoxShadow="{DynamicResource DbxCardShadow}">
      <DockPanel>
        <!-- search box, with what is being searched under it -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,0,0,1" Padding="16,6,16,8">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource IconSearch}" Width="18" Height="18" Foreground="{DynamicResource DbxAccent}" Margin="0,0,10,0" />
              <TextBox x:Name="QueryBox" Grid.Column="1" Classes="bare" Text="{Binding Query, Mode=TwoWay}" Watermark="Type to search…"
                       FontSize="16" MinHeight="40" Padding="0,8" AutomationProperties.Name="Search" />
            </Grid>
            <TextBlock Classes="dim small" Text="{Binding Title}" Margin="28,0,0,0" />
            <!-- which kinds of object are searched -->
            <ItemsControl x:Name="TypeChips" ItemsSource="{Binding TypeToggles}" IsVisible="{Binding HasTypeToggles}" Margin="28,8,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickOpenTypeToggle">
                  <ToggleButton Classes="segment" Margin="0,0,6,2" IsChecked="{Binding IsOn, Mode=TwoWay}" ToolTip.Tip="{Binding Tooltip}"
                                AutomationProperties.Name="{Binding Label}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="13" Height="13" Data="{Binding Icon, Converter={x:Static views:Icons.ByKey}}" />
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <!-- keyboard hints and the count -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,1,0,0" Padding="16,8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="kbd"><TextBlock Text="↑↓" /></Border>
              <TextBlock Classes="dim small" Text="navigate" VerticalAlignment="Center" />
              <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Enter" /></Border>
              <TextBlock Classes="dim small" Text="open" VerticalAlignment="Center" />
              <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Esc" /></Border>
              <TextBlock Classes="dim small" Text="close" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0,0,0" IsVisible="{Binding ScopeHint, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Classes="kbd"><TextBlock Text="Tab" /></Border>
                <TextBlock Classes="dim small" Text="{Binding ScopeHint}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="dim small" Text="{Binding Notice}" TextWrapping="Wrap" TextAlignment="Right"
                       Margin="12,0" VerticalAlignment="Center"
                       IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Grid.Column="2" Classes="faint small" Text="{Binding CountText}" VerticalAlignment="Center"
                       IsVisible="{Binding !IsEmpty}" />
          </Grid>
        </Border>
        <Panel>
          <ListBox x:Name="ResultList" Margin="0,6" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Results">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:QuickOpenItem">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <PathIcon Classes="dim" Data="{Binding Icon, Converter={x:Static views:Icons.ByKey}}" Width="15" Height="15" Margin="0,0,10,0" />
                  <views:HighlightText Grid.Column="1" Source="{Binding DisplayLabel}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="faint small" Text="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Center"
                             IsVisible="{Binding HasDetail}" />
                  <Border Grid.Column="3" Classes="badge" Margin="10,0,0,0" IsVisible="{Binding HasContext}">
                    <TextBlock Classes="small" Text="{Binding Context}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- nothing to show -->
          <StackPanel Classes="empty" Margin="0,28" IsVisible="{Binding IsEmpty}">
            <PathIcon Data="{StaticResource IconSearch}" />
            <TextBlock Classes="dim" Text="{Binding EmptyText}" />
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>
  </Border>
</UserControl>
