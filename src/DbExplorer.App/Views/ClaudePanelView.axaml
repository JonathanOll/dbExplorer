<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbExplorer.App.ViewModels"
             x:Class="DbExplorer.App.Views.ClaudePanelView"
             x:DataType="vm:ClaudePanelViewModel">
  <UserControl.Styles>
    <Style Selector="WrapPanel > Button"><Setter Property="Margin" Value="6,2,0,2" /></Style>
    <Style Selector="Border.diffline"><Setter Property="Padding" Value="8,1" /></Style>
    <Style Selector="Border.diffline.added"><Setter Property="Background" Value="{DynamicResource DbxSuccessBg}" /></Style>
    <Style Selector="Border.diffline.removed"><Setter Property="Background" Value="{DynamicResource DbxErrorBg}" /></Style>
    <Style Selector="SelectableTextBlock.mono, TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource DbxMonoFont}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.box">
      <Setter Property="Background" Value="{DynamicResource DbxContentBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DbxBorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource DbxRadius}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource DbxSurface}" BorderBrush="{DynamicResource DbxBorder}" BorderThickness="1,0,0,0">
    <DockPanel>
      <!-- What this is, what access it uses, close -->
      <Border DockPanel.Dock="Top" Classes="toolbar">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource IconConsole}" Width="14" Height="14" Margin="4,0,8,0" VerticalAlignment="Center"
                    Foreground="{DynamicResource DbxIcon}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="dim small" Text="{Binding AccessText}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding AccessText}" IsVisible="{Binding AccessText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="close" Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconClose}"
                  Command="{Binding CloseCommand}" ToolTip.Tip="Close the panel (Esc), stopping the question" AutomationProperties.Name="Close the Claude panel" />
        </Grid>
      </Border>
      <ProgressBar DockPanel.Dock="Top" Classes="thin" IsIndeterminate="True" IsVisible="{Binding IsRunning}" />

      <!-- The buttons of the current step; they wrap when the panel is narrow -->
      <Border DockPanel.Dock="Bottom" Classes="toolbar" BorderThickness="0,1,0,0">
        <StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,2">
          <TextBlock Classes="dim small" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="4,0"
                     IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <WrapPanel HorizontalAlignment="Right">
            <Button Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" ToolTip.Tip="Change the request" />
            <Button Classes="primary" Content="Continue" Command="{Binding ContinueCommand}" IsVisible="{Binding IsInput}"
                    ToolTip.ShowOnDisabled="True" ToolTip.Tip="Prepare the question (Ctrl+Enter). Type what you need first." />
            <Button Classes="primary" Content="Send to Claude" Command="{Binding SendCommand}" IsVisible="{Binding IsPreview}"
                    ToolTip.Tip="Send exactly the text above. The next questions of this connection go at once." />
            <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" ToolTip.Tip="Stop Claude Code (Esc)" />
            <Button Content="Try again" Command="{Binding RetryCommand}" IsVisible="{Binding CanAskAgain}" />
            <Button Content="Copy answer" Click="OnCopyAnswerClick" IsVisible="{Binding IsDone}" />
            <Button Content="Reject" Command="{Binding RejectCommand}" IsVisible="{Binding HasProposal}"
                    ToolTip.Tip="Drop the proposed change" />
            <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" IsVisible="{Binding HasProposal}"
                    ToolTip.ShowOnDisabled="True"
                    ToolTip.Tip="Put the proposed SQL in the editor as one undo step. Nothing is run." />
          </WrapPanel>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="Body" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" Spacing="12">
          <Border Classes="banner info" Padding="10,8" CornerRadius="{DynamicResource DbxRadius}" IsVisible="{Binding HasMessage}">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Classes="bi" Data="{StaticResource IconInfo}" Margin="0,1,8,0" VerticalAlignment="Top" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <StackPanel Spacing="6" IsVisible="{Binding IsInput}">
            <TextBlock Text="What should the SQL do?" />
            <TextBox x:Name="RequestBox" Text="{Binding Request}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalContentAlignment="Top"
                     Watermark="e.g. the ten customers with the most orders this year" AutomationProperties.Name="Description of the SQL" />
            <TextBlock Classes="dim small" TextWrapping="Wrap" Text="Your words are sent as typed." />
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding IsPreview}">
            <TextBlock Classes="h2" Text="Check what will be sent" />
            <TextBlock TextWrapping="Wrap"
                       Text="Claude Code sends this to Anthropic. Names of tables and columns are included. Nothing is sent until you press Send." />
            <ItemsControl ItemsSource="{Binding Contents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                    <TextBlock Classes="dim" Text="•" Margin="4,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Proposed change, before the explanation: it is what the user acts on -->
          <StackPanel Spacing="6" IsVisible="{Binding HasProposal}">
            <TextBlock Classes="section" Text="PROPOSED CHANGE" />
            <TextBlock Classes="dim small" TextWrapping="Wrap" Text="{Binding ApplyDisabledReason}"
                       IsVisible="{Binding ApplyDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Border Classes="box" Padding="0,4">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Diff}" AutomationProperties.Name="Proposed change">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClaudeDiffRow">
                      <Border Classes="diffline" Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="mono dim" Text="{Binding Sign}" Width="8" />
                          <TextBlock Classes="mono" Text="{Binding Text}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding ShowAnswer}">
            <TextBlock Classes="section" Text="ANSWER" />
            <SelectableTextBlock Text="{Binding Answer}" TextWrapping="Wrap" AutomationProperties.Name="Answer of Claude" />
          </StackPanel>

          <ToggleButton Classes="segment" Content="Show what was sent" IsChecked="{Binding ShowSent}" HorizontalAlignment="Left"
                        IsVisible="{Binding CanToggleSent}" />
          <Border Classes="box" Padding="10,8" IsVisible="{Binding ShowSent}">
            <SelectableTextBlock Classes="mono" Text="{Binding SentText}" TextWrapping="Wrap" AutomationProperties.Name="Text sent to Claude" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
