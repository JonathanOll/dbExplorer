<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbExplorer.App.ViewModels"
             xmlns:views="using:DbExplorer.App.Views"
             x:Class="DbExplorer.App.Views.PlanView"
             x:DataType="vm:PlanResultTab"
             Focusable="True">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:PlanCompareViewModel" x:DataType="vm:PlanCompareViewModel"><views:PlanCompareView /></DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.Styles>
    <StyleInclude Source="avares://DbExplorer/Styles/Plan.axaml" />
    <Style Selector="Border.plannode.selected Border.tile"><Setter Property="Background" Value="{DynamicResource DbxSurface}" /></Style>

    <!-- operators and statements of the lists are rows -->
    <Style Selector="Button.planrow">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid>
  <DockPanel IsVisible="{Binding !IsComparing}">
    <!-- Toolbar: colour by | zoom ... details, copy, save -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Selected.CanColour}">
          <TextBlock Classes="dim small" Text="Colour by" VerticalAlignment="Center" Margin="4,0,4,0" />
          <ToggleButton Classes="segment" Content="Cost" IsChecked="{Binding IsCost, Mode=TwoWay}" IsEnabled="{Binding Selected.CanColourByCost}" Click="OnMetricClick"
                        ToolTip.ShowOnDisabled="True" ToolTip.Tip="Estimated cost of each operator: the optimizer's own measure of where the work is. Only a plan with costs has it (SQLite reports none)." />
          <ToggleButton Classes="segment" Content="Time" IsChecked="{Binding IsTime, Mode=TwoWay}" IsEnabled="{Binding Selected.CanColourByTime}" Click="OnMetricClick"
                        ToolTip.ShowOnDisabled="True" ToolTip.Tip="Time really spent in each operator. Only an actual plan has it." />
          <ToggleButton Classes="segment" Content="Rows" IsChecked="{Binding IsRows, Mode=TwoWay}" IsEnabled="{Binding Selected.CanColourByRows}" Click="OnMetricClick"
                        ToolTip.ShowOnDisabled="True" ToolTip.Tip="Rows each operator produces (log scale). Only a plan with row counts or estimates has it." />
          <Border Classes="vsep" />
          </StackPanel>
          <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconRemove}" Click="OnZoomOutClick" AutomationProperties.Name="Zoom out">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Zoom out (or mouse wheel)" /><Border Classes="kbd"><TextBlock Text="Ctrl+-" /></Border></StackPanel>
            </ToolTip.Tip>
          </Button>
          <TextBlock Classes="dim num" Text="{Binding ZoomText}" MinWidth="38" TextAlignment="Center" VerticalAlignment="Center" />
          <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconAdd}" Click="OnZoomInClick" AutomationProperties.Name="Zoom in">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Zoom in (or mouse wheel)" /><Border Classes="kbd"><TextBlock Text="Ctrl++" /></Border></StackPanel>
            </ToolTip.Tip>
          </Button>
          <Button Classes="ghost" MinHeight="28" Padding="8,0" Content="Fit" VerticalContentAlignment="Center" Click="OnFitClick" AutomationProperties.Name="Fit the plan to the window">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Fit the plan in the window (never below 70%: scroll for the rest)" /><Border Classes="kbd"><TextBlock Text="Ctrl+0" /></Border></StackPanel>
            </ToolTip.Tip>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="ghost" MinHeight="28" Padding="8,0" Command="{Binding AnalyseWithClaudeCommand}" IsVisible="{Binding ShowAnalyse}"
                  ToolTip.Tip="Ask Claude Code about the costly operators and indexes. You see what is sent; nothing is run." AutomationProperties.Name="Analyse the plan with Claude">
            <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconConsole}" Width="12" Height="12" /><TextBlock Text="Ask Claude" /></StackPanel>
          </Button>
          <Button Classes="ghost" MinHeight="28" Padding="8,0" Command="{Binding PinPlanCommand}" IsEnabled="{Binding CanPin}" IsVisible="{Binding !IsSelectedPinned}"
                  ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding PinTooltip}" AutomationProperties.Name="Pin this plan as the baseline">
            <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconPin}" Width="12" Height="12" /><TextBlock Text="Pin plan" /></StackPanel>
          </Button>
          <Button Classes="ghost" MinHeight="28" Padding="8,0" Command="{Binding UnpinPlanCommand}" IsVisible="{Binding IsSelectedPinned}"
                  ToolTip.Tip="This plan is the pinned baseline. Click to unpin it." AutomationProperties.Name="Unpin the plan">
            <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconPin}" Width="12" Height="12" /><TextBlock Text="Pinned" FontWeight="SemiBold" /></StackPanel>
          </Button>
          <Button x:Name="CompareButton" Classes="ghost" MinHeight="28" Padding="8,0" AutomationProperties.Name="Compare this plan with another"
                  ToolTip.Tip="Compare this plan with another one: operator by operator, before and after an index or a rewrite">
            <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource IconCompare}" Width="12" Height="12" /><TextBlock Text="Compare with…" /></StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" Opening="OnCompareOpening">
                <StackPanel MinWidth="300" MaxWidth="420" Spacing="2">
                  <TextBlock Classes="section" Text="BASELINE TO COMPARE WITH" Margin="4,0,4,4" />
                  <ItemsControl ItemsSource="{Binding CompareChoices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlanCompareChoice">
                        <Button Classes="planrow" Tag="{Binding}" Click="OnCompareChoiceClick">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Classes="dim num small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="dim small" TextWrapping="Wrap" Margin="4,2,4,4" IsVisible="{Binding HasNoCompareChoices}"
                             Text="No other plan to compare with yet. Pin this plan, change the query or add an index, then run again: the new plan can be compared with the pinned one." />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Border Classes="vsep" />
          <Button Classes="ghost" MinHeight="28" Padding="8,0" Content="Copy plan" Click="OnCopyPlanClick"
                  ToolTip.Tip="Copy the plan as the server sent it (XML for SQL Server, JSON for PostgreSQL)" AutomationProperties.Name="Copy the plan text" />
          <Button Classes="ghost" MinHeight="28" Padding="8,0" Content="Save plan…" Click="OnSavePlanClick"
                  ToolTip.Tip="Save the plan to a file. A SQL Server .sqlplan file opens in SSMS and in Azure Data Studio." AutomationProperties.Name="Save the plan to a file" />
          <Border Classes="vsep" />
          <ToggleButton Classes="segment" Content="Details" IsChecked="{Binding ShowSidePanel, Mode=TwoWay}"
                        ToolTip.Tip="Show or hide the panel with the properties, the costliest operators and the issues" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Several statements: one chip each, with its share of the batch -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,0,0,1" Padding="8,6,8,2" IsVisible="{Binding HasSeveralStatements}">
      <ItemsControl ItemsSource="{Binding Statements}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlanStatementViewModel">
            <Button Classes="ghost" MinHeight="26" Padding="10,0" Margin="0,0,6,4" Tag="{Binding}" Click="OnStatementClick" ToolTip.Tip="{Binding StatementPreview}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource DbxMonoFontSize}" VerticalAlignment="Center" />
                <TextBlock Classes="dim small" Text="{Binding Subtitle}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- The statement the canvas shows -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,6">
      <StackPanel Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Selected.Title}" FontWeight="SemiBold" FontSize="{DynamicResource DbxMonoFontSize}" VerticalAlignment="Center" />
          <TextBlock Classes="dim num" Text="{Binding Selected.Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Text="{Binding Selected.StatementPreview}" FontFamily="{DynamicResource DbxMonoFont}" FontSize="{DynamicResource DbxMonoFontSize}"
                   Foreground="{DynamicResource DbxTextDim}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Selected.StatementText}" />
      </StackPanel>
    </Border>

    <!-- Save plan failed: said here, the tab stays usable -->
    <Border DockPanel.Dock="Top" Classes="banner error" IsVisible="{Binding HasSaveError}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Classes="bi" Data="{StaticResource IconError}" Margin="0,1,10,0" VerticalAlignment="Center" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding SaveError}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Theme="{StaticResource DbxToolButton}" Classes="close" Tag="{StaticResource IconClose}" Margin="12,0,0,0" VerticalAlignment="Center"
                Command="{Binding DismissSaveErrorCommand}" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss the save error" />
      </Grid>
    </Border>

    <!-- A missing index is the one thing worth saying before the picture -->
    <Border DockPanel.Dock="Top" Classes="banner warn" IsVisible="{Binding Selected.HasMissingIndex}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <PathIcon Classes="bi" Data="{StaticResource IconWarning}" Margin="0,1,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Selected.MissingIndexText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Classes="ghost" MinHeight="26" Padding="8,0" Content="Copy CREATE INDEX" Click="OnCopyIndexClick" ToolTip.Tip="Copy the statement that creates the suggested index" />
          <Button Classes="ghost" MinHeight="26" Padding="8,0" Content="Show issues" Click="OnShowIssuesClick"
                  ToolTip.Tip="Open the Issues tab of the details panel: the suggested index and every other warning" AutomationProperties.Name="Show the issues of the plan" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="Body">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="200" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="360" MinWidth="240" MaxWidth="720" />
      </Grid.ColumnDefinitions>

      <!-- The plan: the root on the left, data flowing right to left -->
      <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="True" Background="{DynamicResource DbxContentBg}"
                    AutomationProperties.Name="Execution plan">
        <LayoutTransformControl x:Name="Zoomer" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Grid Width="{Binding Selected.CanvasWidth}" Height="{Binding Selected.CanvasHeight}">
            <views:PlanEdges Statement="{Binding Selected}" />
            <ItemsControl ItemsSource="{Binding Selected.Nodes}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:PlanNodeViewModel">
                  <Setter Property="Canvas.Left" Value="{Binding X}" />
                  <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanNodeViewModel">
                  <Border Classes="plannode" Classes.selected="{Binding IsSelected}" Classes.path="{Binding IsOnPath}"
                          Width="{Binding Width}" Height="{Binding Height}" ToolTip.Tip="{Binding ToolTipText}"
                          AutomationProperties.Name="{Binding AutomationName}" PointerPressed="OnNodePressed" DoubleTapped="OnNodeDoubleTapped">
                    <Grid RowDefinitions="*,Auto" Margin="0,0,0,0">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,7,8,2">
                        <Border Classes="tile" VerticalAlignment="Top">
                          <PathIcon Data="{Binding IconKey, Converter={x:Static views:Icons.ByKey}}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="0">
                          <TextBlock Classes="nodetitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="dim nodemeta" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <TextBlock Classes="dim nodemeta" Text="{Binding RowsText}" TextTrimming="CharacterEllipsis" IsVisible="{Binding RowsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <PathIcon Grid.Column="2" Classes="warn" Data="{StaticResource IconWarning}" Width="13" Height="13" VerticalAlignment="Top" Margin="4,0,0,0" IsVisible="{Binding HasWarning}" />
                        <PathIcon Grid.Column="2" Classes="hint" Data="{StaticResource IconInfo}" Width="13" Height="13" VerticalAlignment="Top" Margin="4,0,0,0"
                                  IsVisible="{Binding ShowHintOnly}" />
                      </Grid>
                      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,0,8,7" IsVisible="{Binding HasCost}">
                        <views:HeatBar Classes.low="{Binding IsLow}" Classes.mid="{Binding IsMid}" Classes.high="{Binding IsHigh}"
                                       Value="{Binding Heat}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="cost nodemeta" Classes.mid="{Binding IsMid}" Classes.high="{Binding IsHigh}" Text="{Binding CostText}"
                                   Margin="8,0,0,0" MinWidth="26" TextAlignment="Right" />
                      </Grid>
                      <TextBlock Grid.Row="1" Classes="dim nodemeta" Margin="8,0,8,7" Text="{Binding TimeText}"
                                 IsVisible="{Binding !HasCost}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </LayoutTransformControl>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="6" Background="Transparent" IsVisible="{Binding ShowSidePanel}"
                    AutomationProperties.Name="Resize the details panel" />

      <!-- Properties of the selected operator | the costliest operators | everything that looks wrong -->
      <Border Grid.Column="2" x:Name="SidePanel" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="1,0,0,0" IsVisible="{Binding ShowSidePanel}">
        <TabControl x:Name="SideTabs" Theme="{StaticResource DbxSubTabControl}" ItemContainerTheme="{StaticResource DbxSubTabItem}">
          <TabItem Header="Properties">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="12,8,12,6" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Selected.SelectedTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Selected.SelectedIssues}" IsVisible="{Binding Selected.HasSelectedIssues}" Margin="8,8,8,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlanIssue">
                        <Border Classes="banner" Classes.warn="{Binding IsWarning}" Classes.info="{Binding IsHintKind}" Margin="0,0,0,6" Padding="10,6">
                          <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Classes="bi" Data="{StaticResource IconWarning}" Margin="0,1,8,0" VerticalAlignment="Top" Width="14" Height="14" IsVisible="{Binding IsWarning}" />
                            <PathIcon Classes="bi" Data="{StaticResource IconInfo}" Margin="0,1,8,0" VerticalAlignment="Top" Width="14" Height="14" IsVisible="{Binding IsHintKind}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{DynamicResource DbxMonoFontSize}" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Selected.Properties}" Margin="0,4,0,12">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PlanPropertyRow">
                        <Grid>
                          <TextBlock Classes="section" Text="{Binding Name}" IsVisible="{Binding IsHeader}" Margin="12,10,12,2" />
                          <Grid ColumnDefinitions="128,*" Margin="12,2,12,2" IsVisible="{Binding IsEntry}">
                            <TextBlock Classes="dim" Text="{Binding Name}" TextWrapping="Wrap" FontSize="{DynamicResource DbxMonoFontSize}" Margin="0,0,8,0" />
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="{DynamicResource DbxMonoFontSize}" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <TabItem Header="Top operators">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Classes="dim small" TextWrapping="Wrap" Margin="12,10,12,4"
                           Text="Where the work is, costliest first. Click one to find it in the plan." />
                <ItemsControl ItemsSource="{Binding Selected.Top}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanTopRow">
                      <Button Classes="planrow" Tag="{Binding Node}" Click="OnTopRowClick">
                        <Grid ColumnDefinitions="22,*,Auto,Auto">
                          <TextBlock Classes="dim num" Text="{Binding Rank}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource DbxMonoFontSize}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="dim small" Text="{Binding Object}" TextTrimming="CharacterEllipsis" IsVisible="{Binding Object, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Classes="dim num" Text="{Binding Rows}" Margin="8,0,0,0" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Classes="cost" Classes.mid="{Binding Node.IsMid}" Classes.high="{Binding Node.IsHigh}" Text="{Binding Share}"
                                     Margin="10,0,0,0" MinWidth="38" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{Binding Selected.IssueCount, StringFormat='Issues ({0})'}" x:Name="IssuesTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <StackPanel Classes="empty" IsVisible="{Binding Selected.HasNoIssues}" Margin="12,40,12,0">
                  <PathIcon Data="{StaticResource IconCheck}" />
                  <TextBlock Classes="dim" Text="Nothing suspicious: no warning, no missing index, no scan that an index would avoid." />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Selected.Issues}" Margin="8,8,8,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanIssue">
                      <Border Classes="banner" Classes.warn="{Binding IsWarning}" Classes.info="{Binding IsHintKind}" Classes.error="False" Margin="0,0,0,6" Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*">
                          <PathIcon Classes="bi" Data="{StaticResource IconWarning}" Margin="0,1,8,0" VerticalAlignment="Top" Width="14" Height="14" IsVisible="{Binding IsWarning}" />
                          <PathIcon Classes="bi" Data="{StaticResource IconInfo}" Margin="0,1,8,0" VerticalAlignment="Top" Width="14" Height="14" IsVisible="{Binding IsHintKind}" />
                          <PathIcon Classes="bi" Data="{StaticResource IconKey}" Margin="0,1,8,0" VerticalAlignment="Top" Width="14" Height="14" IsVisible="{Binding IsIndex}" />
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{DynamicResource DbxMonoFontSize}" IsVisible="{Binding !IsIndex}" />
                            <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{DynamicResource DbxMonoFontSize}" IsVisible="{Binding IsIndex}"
                                                 FontFamily="{DynamicResource DbxMonoFont}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                              <Button Classes="ghost" MinHeight="24" Padding="8,0" Content="Show in plan" Tag="{Binding Node}" Click="OnIssueShowClick" IsVisible="{Binding HasNode}" />
                              <Button Classes="ghost" MinHeight="24" Padding="8,0" Content="Copy script" Tag="{Binding Script}" Click="OnIssueCopyClick" IsVisible="{Binding HasScript}" />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>

  <!-- Compare mode: two plans and what differs, in place of the plan -->
  <ContentControl Content="{Binding Comparison}" IsVisible="{Binding IsComparing}" />
  </Grid>
</UserControl>
