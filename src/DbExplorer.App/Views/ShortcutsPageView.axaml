<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbExplorer.App.ViewModels"
             x:Class="DbExplorer.App.Views.ShortcutsPageView"
             x:DataType="vm:ShortcutsSettingsPage">
  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox Text="{Binding SearchText}" Watermark="Filter by key or action" AutomationProperties.Name="Filter the shortcuts" />
      <Button Grid.Column="1" Command="{Binding CopyMarkdownCommand}" ToolTip.Tip="Copy the whole list as a markdown table"
              AutomationProperties.Name="Copy the shortcuts as markdown">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
          <TextBlock Text="Copy as markdown" />
        </StackPanel>
      </Button>
    </Grid>

    <ItemsControl ItemsSource="{Binding VisibleSections}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:ShortcutGroupViewModel">
          <StackPanel Margin="0,0,0,18" Spacing="2">
            <TextBlock Classes="section" Text="{Binding Title}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="190,*" Margin="0,4">
                    <Border Classes="kbd" HorizontalAlignment="Left"><TextBlock Text="{Binding Keys}" /></Border>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Classes="empty" IsVisible="{Binding HasNoShortcuts}">
      <PathIcon Data="{StaticResource IconSearch}" />
      <TextBlock Classes="h2" Text="No shortcut matches" />
      <TextBlock Classes="dim" Text="Try a key such as Ctrl+T, or a word such as tab." />
    </StackPanel>
  </StackPanel>
</UserControl>
