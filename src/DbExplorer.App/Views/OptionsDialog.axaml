<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbExplorer.App.ViewModels"
        xmlns:views="using:DbExplorer.App.Views"
        x:Class="DbExplorer.App.Views.OptionsDialog"
        x:DataType="vm:OptionsViewModel"
        Title="Options"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <views:DialogFooter DockPanel.Dock="Bottom">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Save" Classes="accent" IsDefault="True" Click="OnOkClick" MinWidth="88" HorizontalContentAlignment="Center" />
        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" MinWidth="88" HorizontalContentAlignment="Center" />
      </StackPanel>
    </views:DialogFooter>

    <views:DialogHeader DockPanel.Dock="Top" Icon="{StaticResource IconSettings}" Title="Options"
                        Subtitle="Settings kept in the config file." />

    <Border Background="{DynamicResource DbxContentBg}" Padding="24,20,24,24">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="N2F DATABASE UPDATES" Margin="0" />

        <StackPanel Spacing="4">
          <Label Content="_dbupdate folder" Target="{Binding #PathBox}" Padding="0" FontWeight="SemiBold" />
          <TextBlock Classes="dim small" TextWrapping="Wrap"
                     Text="The dbupdate folder of the n2f repo (Web/Common/n2jWeb.Data/dbupdate). Leave it empty to switch the upgrade feature off." />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="PathBox" Text="{Binding DbUpdatePath}" Watermark="C:\repos\n2f\Web\Common\n2jWeb.Data\dbupdate"
                   Classes.error="{Binding HasPathError}" />
          <Button Grid.Column="1" Content="Choose folder…" Margin="8,0,0,0" Click="OnBrowseClick" ToolTip.Tip="Pick the dbupdate folder" />
        </Grid>

        <!-- What the folder is: checking, not usable (and why), usable, or not set -->
        <Panel MinHeight="20">
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsChecking}">
            <PathIcon Classes="spin" Data="{StaticResource IconRefresh}" Width="12" Height="12" Foreground="{DynamicResource DbxAccent}" />
            <TextBlock Classes="dim small" Text="Checking the folder…" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="fielderror" Text="{Binding PathError}" TextWrapping="Wrap" IsVisible="{Binding HasPathError}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PathInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
            <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="{DynamicResource DbxSuccess}" VerticalAlignment="Center" />
            <TextBlock Classes="small" Text="{Binding PathInfo}" Foreground="{DynamicResource DbxSuccessText}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="dim small" Text="{Binding FeatureHint}" TextWrapping="Wrap" IsVisible="{Binding ShowHint}" />
        </Panel>

        <Border Height="1" Margin="0,6" Background="{DynamicResource DbxBorderSubtle}" />

        <TextBlock Classes="section" Text="SQL FORMATTING" Margin="0" />
        <TextBlock Classes="dim small" TextWrapping="Wrap"
                   Text="How Ctrl+Shift+F lays out a script. Only whitespace and the case of keywords change." />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
          <Label Grid.Row="0" Content="_Keywords" Target="{Binding #KeywordCaseBox}" VerticalAlignment="Center" Padding="0" />
          <ComboBox x:Name="KeywordCaseBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Static vm:OptionsViewModel.KeywordCaseChoices}" SelectedIndex="{Binding KeywordCaseIndex}" />
          <Label Grid.Row="1" Content="_Indent" Target="{Binding #IndentBox}" VerticalAlignment="Center" Padding="0" />
          <ComboBox x:Name="IndentBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Static vm:OptionsViewModel.IndentChoices}" SelectedIndex="{Binding IndentIndex}" />
          <Label Grid.Row="2" Content="C_ommas" Target="{Binding #CommaBox}" VerticalAlignment="Center" Padding="0" />
          <ComboBox x:Name="CommaBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Static vm:OptionsViewModel.CommaChoices}" SelectedIndex="{Binding CommaIndex}" />
        </Grid>

        <TextBlock Classes="dim small" Text="Preview" Margin="0,4,0,0" />
        <Border Background="{DynamicResource DbxInputBg}" BorderBrush="{DynamicResource DbxBorder}" BorderThickness="1"
                CornerRadius="{DynamicResource DbxRadius}" Padding="10,8">
          <TextBlock x:Name="PreviewText" Text="{Binding Preview}" FontFamily="{DynamicResource DbxMonoFont}" FontSize="12"
                     Foreground="{DynamicResource DbxText}" TextWrapping="NoWrap" MinHeight="170"
                     AutomationProperties.Name="Preview of the formatted sample statement" />
        </Border>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
