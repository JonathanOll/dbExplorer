<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DbExplorer.App.ViewModels"
             xmlns:views="using:DbExplorer.App.Views"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="DbExplorer.App.Views.ScriptTabView"
             x:DataType="vm:ScriptTabViewModel">
  <UserControl.Styles>
    <!-- AvaloniaEdit's theme is part of this view, not of the application: it is only loaded when the first script tab opens. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <Style Selector="PathIcon.ok"><Setter Property="Foreground" Value="{DynamicResource DbxSuccess}" /></Style>
    <Style Selector="PathIcon.bad"><Setter Property="Foreground" Value="{DynamicResource DbxError}" /></Style>
    <Style Selector="PathIcon.warn"><Setter Property="Foreground" Value="{DynamicResource DbxWarn}" /></Style>
    <Style Selector="PathIcon.run"><Setter Property="Foreground" Value="{DynamicResource DbxAccent}" /></Style>
    <!-- the result line, the run summary and the group header are quiet bands of one height -->
    <Style Selector="Border.strip">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <!-- a little slack after the text: a result line must never lose its last character to rounding of the text width -->
    <Style Selector="Border.strip TextBlock"><Setter Property="Padding" Value="0,0,2,0" /></Style>
    <Style Selector="TextBlock.num">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <!-- What the result strip shows for a statement's result, and for the Statistics / Messages grids (one table each) -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:StatementResultViewModel" x:DataType="vm:StatementResultViewModel">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatementResultContent}" />
    </DataTemplate>
    <DataTemplate DataType="vm:PlanResultTab" x:DataType="vm:PlanResultTab">
      <views:PlanView />
    </DataTemplate>
    <DataTemplate DataType="vm:GridResultTab" x:DataType="vm:GridResultTab">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="toolbar strip" BorderThickness="0,1,0,0">
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
        <Grid>
          <views:ResultGrid ClientSort="True" Columns="{Binding Columns}" ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}" />
          <StackPanel Classes="empty" IsVisible="{Binding IsEmpty}">
            <PathIcon Data="{StaticResource IconInfo}" />
            <TextBlock Classes="dim" Text="{Binding EmptyText}" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Resources>
    <!-- Copy and Export of one result set, with the counter of selected rows. In the result line for one set, in the set header for several. -->
    <DataTemplate x:Key="ResultSetActions" x:DataType="vm:ResultSetViewModel">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBlock Classes="dim small" Text="{Binding SelectionText}" IsVisible="{Binding HasSelection}" Margin="0,0,6,0" VerticalAlignment="Center" />
        <Button Classes="ghost" MinHeight="24" Padding="8,0" Content="Copy" Click="OnCopyResultClick"
                ToolTip.Tip="{Binding CopyTip}" AutomationProperties.Name="Copy the rows" />
        <DropDownButton Classes="ghost" MinHeight="24" Padding="8,0" Content="Export" Click="OnExportMenuClick"
                        ToolTip.Tip="Export as CSV or JSON: the selected rows, or all rows" AutomationProperties.Name="Export the rows">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedRight">
              <MenuItem Header="Export as CSV…" Click="OnExportCsvClick" />
              <MenuItem Header="Export as JSON…" Click="OnExportJsonClick" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </StackPanel>
    </DataTemplate>

    <!-- What one statement (or one member of a group run) produced: result line, error banner, result grids. -->
    <DataTemplate x:Key="StatementResultContent" x:DataType="vm:StatementResultViewModel">
      <DockPanel>
        <!-- Result line: "60 rows · 12 ms" on the left, the row-limit warning and its action on the right -->
        <Border DockPanel.Dock="Bottom" Classes="toolbar strip" BorderThickness="0,1,0,0">
          <!-- the detail sits in the star column: its text can never be cut by a stale arrange width -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="{Binding StatusMain}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Padding="0,0,6,0" />
            <TextBlock Grid.Column="1" Classes="dim num" Margin="2,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding StatusDetail, StringFormat='· {0}'}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <ContentControl Content="{Binding SingleSet}" ContentTemplate="{StaticResource ResultSetActions}"
                              IsVisible="{Binding SingleSet, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Border Classes="badge warn" IsVisible="{Binding IsTruncated}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconWarning}" Width="11" Height="11" />
                  <TextBlock Text="{Binding TruncatedNotice}" FontSize="11.5" />
                </StackPanel>
              </Border>
              <Button Classes="ghost" MinHeight="24" Padding="8,0" Content="Raise limit" Click="OnRaiseLimitClick" IsVisible="{Binding IsTruncated}"
                      ToolTip.Tip="Multiply the row limit by 10 and run again" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Error: a failure is red, a statement the read-only guard refused is amber with a lock -->
        <Border DockPanel.Dock="Top" Classes="banner" Classes.error="{Binding IsFailure}" Classes.warn="{Binding IsBlocked}"
                IsVisible="{Binding HasError}">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <PathIcon Classes="bi" Grid.RowSpan="2" Data="{StaticResource IconError}" Margin="0,1,10,0" VerticalAlignment="Top"
                      IsVisible="{Binding IsFailure}" />
            <PathIcon Classes="bi" Grid.RowSpan="2" Data="{StaticResource IconLock}" Margin="0,1,10,0" VerticalAlignment="Top"
                      IsVisible="{Binding IsBlocked}" />
            <TextBlock Grid.Column="1" Text="{Binding ErrorTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ScrollViewer Grid.Column="1" Grid.Row="1" MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
              <SelectableTextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" FontFamily="{DynamicResource DbxMonoFont}" FontSize="12" />
            </ScrollViewer>
            <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Margin="12,0,0,0">
              <Button Classes="ghost" MinHeight="26" Padding="8,0" Content="Go to statement" Click="OnGoToStatementClick"
                      IsVisible="{Binding HasRange}" ToolTip.Tip="Select the statement in the editor" />
              <Button Classes="ghost" MinHeight="26" Padding="8,0" Content="Copy" Click="OnCopyErrorClick"
                      ToolTip.Tip="Copy the error message" AutomationProperties.Name="Copy the error message" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid>
          <!-- A statement that worked and returned no rows: say so instead of leaving the area blank -->
          <StackPanel Classes="empty" IsVisible="{Binding ShowNoResult}">
            <PathIcon Data="{StaticResource IconCheck}" />
            <TextBlock Classes="h2" Text="{Binding NoResultText}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Sets}" IsVisible="{Binding HasSets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ResultSetViewModel">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Classes="toolbar strip" MinHeight="26" BorderThickness="0,1,0,1" IsVisible="{Binding ShowTitle}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="dim small" Text="{Binding Title}" VerticalAlignment="Center" />
                      <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource ResultSetActions}" />
                    </Grid>
                  </Border>
                  <views:ResultGrid Columns="{Binding Columns}" ItemsSource="{Binding Rows}" SelectedRowsChanged="OnResultSelectionChanged" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <!-- Toolbar: run | group | limit and statistics | files on the left; what is running, Stop, the connection on the right -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Theme="{StaticResource DbxToolButton}" Classes="accent" Tag="{StaticResource IconPlay}" Content="Run"
                  Command="{Binding RunStatementCommand}" IsEnabled="{Binding CanRun}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="Run statement">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Run the selection, or the statement at the caret" IsVisible="{Binding CanRun}" />
                <TextBlock Text="{Binding RunDisabledReason}" IsVisible="{Binding !CanRun}" />
                <Border Classes="kbd" IsVisible="{Binding CanRun}"><TextBlock Text="Ctrl+Enter" /></Border>
              </StackPanel>
            </ToolTip.Tip>
          </Button>
          <Button Theme="{StaticResource DbxToolButton}" Classes="run" Tag="{StaticResource IconPlayAll}" Content="Run all"
                  Command="{Binding RunScriptCommand}" IsEnabled="{Binding CanRun}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="Run the whole script">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Run the whole script, statement by statement" IsVisible="{Binding CanRun}" />
                <TextBlock Text="{Binding RunDisabledReason}" IsVisible="{Binding !CanRun}" />
                <Border Classes="kbd" IsVisible="{Binding CanRun}"><TextBlock Text="F5" /></Border>
              </StackPanel>
            </ToolTip.Tip>
          </Button>

          <!-- Run on group: read-only on every database of the group, whatever each connection's own flag says -->
          <Border Classes="vsep" IsVisible="{Binding HasGroupSwitch}" />
          <DropDownButton x:Name="GroupRunButton" Classes="ghost" MinHeight="30" Padding="8,0" VerticalAlignment="Center"
                         IsVisible="{Binding HasGroupSwitch}" IsEnabled="{Binding CanRun}" ToolTip.ShowOnDisabled="True"
                         AutomationProperties.Name="Run on group">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Run on every database of the group, read-only" IsVisible="{Binding CanRun}" />
                <TextBlock Text="{Binding RunDisabledReason}" IsVisible="{Binding !CanRun}" />
              </StackPanel>
            </ToolTip.Tip>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconGroup}" Width="16" Height="16" Foreground="{DynamicResource DbxRun}" />
              <TextBlock Text="Run on group" VerticalAlignment="Center" />
            </StackPanel>
            <DropDownButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Run statement on group" InputGesture="Ctrl+Shift+Enter" Click="OnRunStatementOnGroupMenu" />
                <MenuItem Header="Run script on group" InputGesture="Ctrl+Shift+F5" Click="OnRunScriptOnGroupMenu" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>

          <Border Classes="vsep" />
          <!-- Row limit: one button that says the current limit and opens the presets -->
          <DropDownButton x:Name="RowLimitButton" Classes="ghost" MinHeight="30" Padding="8,0" VerticalAlignment="Center"
                          Content="{Binding RowLimitText}" AutomationProperties.Name="Row limit"
                          ToolTip.Tip="Maximum rows kept per result set (per database in a group run)">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Width="188" Spacing="2">
                  <TextBlock Classes="section" Text="Rows kept per result" Margin="6,2,0,4" />
                  <ItemsControl ItemsSource="{x:Static vm:ScriptTabViewModel.RowLimitPresets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:Int32">
                        <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0" MinHeight="28"
                                Tag="{Binding}" Content="{Binding StringFormat='{}{0:N0} rows'}" Click="OnRowLimitPresetClick" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Height="1" Margin="0,4" Background="{DynamicResource DbxBorderSubtle}" />
                  <TextBlock Classes="dim small" Text="Custom (1 to 100,000), then Enter" Margin="6,0,0,2" />
                  <TextBox Watermark="e.g. 2500" MinHeight="28" Padding="8,3" KeyDown="OnCustomRowLimitKeyDown"
                           AutomationProperties.Name="Custom row limit" />
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <ToggleButton Classes="segment" Content="Statistics" IsChecked="{Binding StatisticsEnabled}" IsVisible="{Binding CanUseStatistics}"
                        VerticalAlignment="Center" Margin="4,0,0,0"
                        ToolTip.Tip="SQL Server: capture STATISTICS IO and TIME on the next runs and show the Statistics and Messages tabs" />

          <Border Classes="vsep" />
          <!-- Execution plans: the estimated one runs nothing; the actual one rides along with every run -->
          <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconSchema}" Content="Plan"
                  Command="{Binding ShowEstimatedPlanCommand}" IsEnabled="{Binding CanRun}" ToolTip.ShowOnDisabled="True"
                  AutomationProperties.Name="Show the estimated execution plan">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Show the estimated plan of the selection or the statement at the caret. Nothing is run." IsVisible="{Binding CanRun}" />
                <TextBlock Text="{Binding RunDisabledReason}" IsVisible="{Binding !CanRun}" />
                <Border Classes="kbd" IsVisible="{Binding CanRun}"><TextBlock Text="Ctrl+L" /></Border>
              </StackPanel>
            </ToolTip.Tip>
          </Button>
          <ToggleButton Classes="segment" Content="Actual plan" IsChecked="{Binding ActualPlanEnabled}" IsVisible="{Binding CanUseActualPlan}"
                        VerticalAlignment="Center" Margin="4,0,0,0" ToolTip.Tip="{Binding ActualPlanTip}" AutomationProperties.Name="Include the actual execution plan" />

          <Border Classes="vsep" />
          <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconFormat}"
                  Command="{Binding FormatSqlCommand}" AutomationProperties.Name="Format SQL">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Format the selection, or the whole script" />
                <Border Classes="kbd"><TextBlock Text="Ctrl+Shift+F" /></Border>
              </StackPanel>
            </ToolTip.Tip>
          </Button>
          <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconFileOpen}"
                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenScriptFileCommand}"
                  AutomationProperties.Name="Open a script file">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Open a script file in a new tab" />
                <Border Classes="kbd"><TextBlock Text="Ctrl+O" /></Border>
              </StackPanel>
            </ToolTip.Tip>
          </Button>
          <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconSave}" Command="{Binding SaveCommand}"
                  AutomationProperties.Name="Save the script to a file">
            <ToolTip.Tip>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Save the script to a file" />
                <Border Classes="kbd"><TextBlock Text="Ctrl+S" /></Border>
              </StackPanel>
            </ToolTip.Tip>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
          <!-- What is running, for how long, and Stop. Lives on the right so appearing never moves the buttons on the left. -->
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
            <PathIcon Classes="spin run" Data="{StaticResource IconRefresh}" Width="14" Height="14" IsVisible="{Binding IsBusy}" />
            <TextBlock Classes="dim" Text="{Binding RunProgressText}" VerticalAlignment="Center" />
            <TextBlock x:Name="ElapsedText" Classes="dim num" VerticalAlignment="Center" />
            <Button Theme="{StaticResource DbxToolButton}" Classes="stop" Tag="{StaticResource IconStop}" Content="Stop"
                    Command="{Binding CancelCommand}" AutomationProperties.Name="Stop the run">
              <ToolTip.Tip>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Stop the running script or group run" />
                  <Border Classes="kbd"><TextBlock Text="Esc" /></Border>
                  <Border Classes="kbd"><TextBlock Text="Ctrl+Break" /></Border>
                </StackPanel>
              </ToolTip.Tip>
            </Button>
          </StackPanel>

          <views:GroupSwitcher />

          <!-- The connection this script runs on; the selector above replaces it when the connection is in a group -->
          <Border Classes="badge" ToolTip.Tip="{Binding ConnectionDescription}" IsVisible="{Binding !HasGroupSwitch}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <views:EngineIcon Kind="{Binding Connection.Kind}" Width="12" Height="12" />
              <TextBlock Text="{Binding Connection.Name}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="dim small" Text="{Binding Connection.Kind}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Classes="badge warn" IsVisible="{Binding IsReadOnly}"
                  ToolTip.Tip="This connection refuses INSERT, UPDATE, DELETE and schema changes. Turn read-only off in the connection settings to write.">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource IconLock}" Width="11" Height="11" />
              <TextBlock Text="Read-only" FontSize="11.5" />
            </StackPanel>
          </Border>

          <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconKeyboard}" AutomationProperties.Name="Script shortcuts">
            <ToolTip.Tip>Keyboard shortcuts of the script editor</ToolTip.Tip>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel MinWidth="300" Spacing="4">
                  <TextBlock Classes="section" Text="Script shortcuts" Margin="0,0,0,2" />
                  <ItemsControl ItemsSource="{x:Static views:ScriptTabKeys.Shortcuts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="views:ScriptShortcut">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Classes="kbd" Margin="16,0,0,0"><TextBlock Text="{Binding Keys}" /></Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <ProgressBar DockPanel.Dock="Top" Classes="thin" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

    <!-- Run-level problem: connection closed or reset, cannot connect, file problem. Red for a failure, amber for a caution. -->
    <Border DockPanel.Dock="Top" Classes="banner" Classes.error="{Binding !ErrorIsWarning}" Classes.warn="{Binding ErrorIsWarning}"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <PathIcon Classes="bi" Data="{StaticResource IconError}" Margin="0,1,10,0" VerticalAlignment="Top" IsVisible="{Binding !ErrorIsWarning}" />
        <PathIcon Classes="bi" Data="{StaticResource IconWarning}" Margin="0,1,10,0" VerticalAlignment="Top" IsVisible="{Binding ErrorIsWarning}" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding ErrorTitle}" FontWeight="SemiBold" IsVisible="{Binding ErrorTitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
          </ScrollViewer>
          <TextBlock Text="{Binding ErrorHint}" FontSize="11.5" Opacity="0.85" TextWrapping="Wrap"
                     IsVisible="{Binding ErrorHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="accent" Margin="12,0,0,0" MinHeight="28" Padding="10,0" Content="Reconnect" VerticalAlignment="Center"
                Command="{Binding ReconnectCommand}" IsVisible="{Binding NeedsReconnect}" ToolTip.Tip="Open a new connection for this tab" />
        <Button Grid.Column="3" Classes="close" Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconClose}" Margin="4,0,0,0"
                VerticalAlignment="Top" Command="{Binding DismissErrorCommand}" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss" />
      </Grid>
    </Border>

    <Grid x:Name="SplitGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="4*" MinHeight="80" />
        <RowDefinition Height="6" />
        <RowDefinition Height="6*" MinHeight="120" />
      </Grid.RowDefinitions>
      <!-- The key hint at the bottom right shows only while the editor is empty -->
      <Border Grid.Row="0" Background="{DynamicResource DbxContentBg}">
        <Grid>
          <ae:TextEditor x:Name="Editor" ShowLineNumbers="True" WordWrap="False"
                         FontFamily="{DynamicResource DbxMonoFont}" FontSize="13"
                         Background="{DynamicResource DbxContentBg}" Foreground="{DynamicResource DbxText}"
                         Padding="6,8,12,8"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="SQL editor" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,10"
                      IsHitTestVisible="False" IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}">
            <Border Classes="kbd"><TextBlock Text="Ctrl+Enter" /></Border>
            <TextBlock Classes="faint small" Text="run" VerticalAlignment="Center" />
            <Border Classes="kbd" Margin="8,0,0,0"><TextBlock Text="F5" /></Border>
            <TextBlock Classes="faint small" Text="run all" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter x:Name="PaneSplitter" Grid.Row="1" ResizeDirection="Rows" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    DoubleTapped="OnSplitterDoubleTapped" AutomationProperties.Name="Resize the editor and the results"
                    ToolTip.Tip="Drag to resize. Double-click to maximize the results, double-click again to restore" />

      <!-- One tab per executed statement, or the group run (status panel + result tabs) -->
      <Grid Grid.Row="2" Background="{DynamicResource DbxContentBg}">
        <Grid IsVisible="{Binding GroupRun, Converter={x:Static ObjectConverters.IsNull}}">
          <!-- Nothing ran yet: what to do, not only which keys -->
          <StackPanel Classes="empty" IsVisible="{Binding !ResultTabs.Count}">
            <PathIcon Data="{StaticResource IconPlay}" />
            <TextBlock Classes="h2" Text="Run a query to see its results" />
            <TextBlock Classes="dim" Text="Select some text to run just that part." />
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Border Grid.Row="0" Classes="kbd" HorizontalAlignment="Right" Margin="0,3,12,3"><TextBlock Text="Ctrl+Enter" /></Border>
              <TextBlock Grid.Row="0" Grid.Column="1" Classes="dim" Text="Run the statement at the caret or the selection" VerticalAlignment="Center" TextAlignment="Left" />
              <Border Grid.Row="1" Classes="kbd" HorizontalAlignment="Right" Margin="0,3,12,3"><TextBlock Text="F5" /></Border>
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="dim" Text="Run the whole script" VerticalAlignment="Center" TextAlignment="Left" />
              <Border Grid.Row="2" Classes="kbd" HorizontalAlignment="Right" Margin="0,3,12,3" IsVisible="{Binding HasGroupSwitch}"><TextBlock Text="Ctrl+Shift+Enter" /></Border>
              <TextBlock Grid.Row="2" Grid.Column="1" Classes="dim" Text="Run on every database of the group (read-only)" VerticalAlignment="Center"
                         TextAlignment="Left" IsVisible="{Binding HasGroupSwitch}" />
              <Border Grid.Row="3" Classes="kbd" HorizontalAlignment="Right" Margin="0,3,12,3" IsVisible="{Binding HasGroupSwitch}"><TextBlock Text="Ctrl+Shift+F5" /></Border>
              <TextBlock Grid.Row="3" Grid.Column="1" Classes="dim" Text="Run the whole script on the group" VerticalAlignment="Center"
                         TextAlignment="Left" IsVisible="{Binding HasGroupSwitch}" />
            </Grid>
          </StackPanel>

          <DockPanel IsVisible="{Binding !!ResultTabs.Count}">
            <!-- How the run went, for a script of several statements or a cancelled one -->
            <Border DockPanel.Dock="Top" Classes="toolbar strip" IsVisible="{Binding HasRunSummary}">
              <Grid ColumnDefinitions="Auto,*">
                <Panel Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                  <PathIcon Classes="ok" Data="{StaticResource IconCheck}" Width="13" Height="13" IsVisible="{Binding RunSummaryIsSuccess}" />
                  <PathIcon Classes="bad" Data="{StaticResource IconError}" Width="13" Height="13" IsVisible="{Binding RunSummaryIsError}" />
                  <PathIcon Classes="dim" Data="{StaticResource IconStop}" Width="13" Height="13" IsVisible="{Binding RunSummaryIsCancelled}" />
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding RunSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <TabControl x:Name="ResultTabStrip" Theme="{StaticResource DbxSubTabControl}" ItemContainerTheme="{StaticResource DbxSubTabItem}"
                        ItemsSource="{Binding ResultTabs}" SelectedItem="{Binding SelectedResultTab}" AutomationProperties.Name="Results">
              <!-- tabs keep their natural width (a WrapPanel here mis-measured and let the banner cover the second row) -->
              <TabControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </TabControl.ItemsPanel>
              <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IResultTab">
                  <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding ToolTipText}" AutomationProperties.Name="{Binding AutomationName}">
                    <PathIcon Classes="ok" Data="{StaticResource IconCheck}" Width="12" Height="12" IsVisible="{Binding ShowOk}" />
                    <PathIcon Classes="bad" Data="{StaticResource IconError}" Width="12" Height="12" IsVisible="{Binding ShowFailure}" />
                    <PathIcon Classes="warn" Data="{StaticResource IconLock}" Width="12" Height="12" IsVisible="{Binding IsBlocked}" />
                    <PathIcon Classes="dim" Data="{StaticResource IconCount}" Width="12" Height="12" IsVisible="{Binding IsGrid}" />
                    <PathIcon Classes="run" Data="{StaticResource IconSchema}" Width="12" Height="12" IsVisible="{Binding IsPlan}" />
                    <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                  </StackPanel>
                </DataTemplate>
              </TabControl.ItemTemplate>
              <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:IResultTab">
                  <ContentControl Content="{Binding}" />
                </DataTemplate>
              </TabControl.ContentTemplate>
            </TabControl>
          </DockPanel>
        </Grid>

        <ContentControl Content="{Binding GroupRun}" IsVisible="{Binding GroupRun, Converter={x:Static ObjectConverters.IsNotNull}}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:GroupRunViewModel">
              <DockPanel>
                <!-- Header: what this is, how far it got, Cancel all while it runs, Close once it ended -->
                <Border DockPanel.Dock="Top" Classes="toolbar strip" IsVisible="{Binding !!Members.Count}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <PathIcon Classes="dim" Data="{StaticResource IconGroup}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="title" Text="Group run" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="dim num" Margin="8,0,0,0" Text="{Binding SummaryText, StringFormat='· {0}'}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Button Theme="{StaticResource DbxToolButton}" Classes="stop" Tag="{StaticResource IconStop}" Content="Cancel all"
                              Command="{Binding CancelAllCommand}" IsVisible="{Binding IsRunning}"
                              ToolTip.Tip="Cancel the group run on every database (Esc or Ctrl+Break)" />
                      <Button Theme="{StaticResource DbxToolButton}" Classes="close" Tag="{StaticResource IconClose}" IsVisible="{Binding !IsRunning}"
                              Command="{Binding $parent[views:ScriptTabView].((vm:ScriptTabViewModel)DataContext).CloseGroupRunPanelCommand}"
                              ToolTip.Tip="Close the group results" AutomationProperties.Name="Close the group results" />
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- One chip per database: state, name, rows and time. A click opens its own tab; the X cancels only that database. -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,6,10,2"
                        IsVisible="{Binding !!Members.Count}">
                  <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MemberStatusViewModel">
                        <Border Classes="badge" Classes.success="{Binding IsDone}" Classes.error="{Binding IsFailed}" Margin="0,0,6,4" Padding="2,0,2,0"
                                ToolTip.Tip="{Binding StatusText}" AutomationProperties.Name="{Binding Name}">
                          <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Classes="ghost" MinHeight="24" Padding="8,0,6,0" CornerRadius="12" Command="{Binding SelectCommand}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Classes="dim" Data="{StaticResource IconSchedule}" Width="12" Height="12" IsVisible="{Binding IsPending}" />
                                <PathIcon Classes="spin run" Data="{StaticResource IconRefresh}" Width="12" Height="12" IsVisible="{Binding IsRunning}" />
                                <PathIcon Classes="ok" Data="{StaticResource IconCheck}" Width="12" Height="12" IsVisible="{Binding IsDone}" />
                                <PathIcon Classes="bad" Data="{StaticResource IconError}" Width="12" Height="12" IsVisible="{Binding IsFailed}" />
                                <PathIcon Classes="dim" Data="{StaticResource IconStop}" Width="12" Height="12" IsVisible="{Binding IsCancelled}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Classes="dim" Text="{Binding ShortStatusText}" FontSize="11.5" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                            <Button Classes="close" Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconClose}" MinHeight="22" MinWidth="22"
                                    Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}"
                                    ToolTip.Tip="Cancel this database only" AutomationProperties.Name="Cancel this database only" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>

                <!-- Notices: the comparison itself (info), then what was left out or refused (warning) -->
                <Border DockPanel.Dock="Top" Classes="banner info" IsVisible="{Binding HasInfoNotices}">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Classes="bi" Data="{StaticResource IconInfo}" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding InfoNotices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
                <Border DockPanel.Dock="Top" Classes="banner warn" IsVisible="{Binding HasWarnNotices}">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Classes="bi" Data="{StaticResource IconWarning}" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding WarnNotices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>

                <TabControl Theme="{StaticResource DbxSubTabControl}" ItemContainerTheme="{StaticResource DbxSubTabItem}"
                            ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" IsVisible="{Binding HasResults}">
                  <TabControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </TabControl.ItemsPanel>
                  <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupResultTab">
                      <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.Name="{Binding AutomationName}">
                        <PathIcon Classes="dim" Data="{StaticResource IconGroup}" Width="12" Height="12" IsVisible="{Binding IsAll}" />
                        <PathIcon Classes="dim" Data="{StaticResource IconCount}" Width="12" Height="12" IsVisible="{Binding IsGrid}" />
                        <PathIcon Classes="bad" Data="{StaticResource IconError}" Width="12" Height="12" IsVisible="{Binding HasError}" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                      </StackPanel>
                    </DataTemplate>
                  </TabControl.ItemTemplate>
                  <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:GroupResultTab">
                      <Grid>
                        <!-- All: the rows of every member with a leading Database column, or only the rows that differ -->
                        <DockPanel IsVisible="{Binding IsAll}">
                          <Border DockPanel.Dock="Top" Classes="toolbar" MinHeight="40" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <ToggleButton Classes="segment" Content="All rows" IsChecked="{Binding Run.ShowAllRows}" Click="OnSegmentClick"
                                            ToolTip.Tip="Every row of every database, with the database it came from" />
                              <ToggleButton Classes="segment" Content="Differences" IsChecked="{Binding Run.ShowDifferences}"
                                            IsEnabled="{Binding Run.CanShowDifferences}" Click="OnSegmentClick" ToolTip.ShowOnDisabled="True"
                                            ToolTip.Tip="Only the rows that are not identical in all databases, with the databases that have them" />
                              <Border Classes="badge" Classes.success="{Binding Run.IsIdentical}" Classes.warn="{Binding !Run.IsIdentical}"
                                      IsVisible="{Binding Run.HasDifferenceChip}" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Run.DifferenceChipText}" FontSize="11.5" />
                              </Border>
                            </StackPanel>
                          </Border>
                          <Border DockPanel.Dock="Bottom" Classes="toolbar strip" BorderThickness="0,1,0,0">
                            <TextBlock Text="{Binding Run.AllStatus}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Border>
                          <views:ResultGrid Columns="{Binding Run.AllColumns}" ItemsSource="{Binding Run.AllRows}" />
                        </DockPanel>
                        <ContentControl Content="{Binding Member}" ContentTemplate="{StaticResource StatementResultContent}"
                                        IsVisible="{Binding IsMember}" />
                        <!-- Statistics / Messages of a run with statistics on: the same grids, with a Database column -->
                        <ContentControl Content="{Binding Grid}" IsVisible="{Binding IsGrid}" />
                      </Grid>
                    </DataTemplate>
                  </TabControl.ContentTemplate>
                </TabControl>
              </DockPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
