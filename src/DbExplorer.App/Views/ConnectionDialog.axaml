<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbExplorer.App.ViewModels"
        xmlns:views="using:DbExplorer.App.Views"
        xmlns:model="using:DbExplorer.Core.Model"
        x:Class="DbExplorer.App.Views.ConnectionDialog"
        x:DataType="vm:ConnectionDialogViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- Field captions: dim, top aligned with the text of a 32 px box so an error line under the box never moves them -->
    <Style Selector="Label.cap">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,7,12,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Foreground" Value="{DynamicResource DbxTextDim}" />
    </Style>
    <!-- "Show" / "Hide" inside the password box -->
    <Style Selector="ToggleButton.reveal">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource DbxTextDim}" />
    </Style>
    <Style Selector="ToggleButton.reveal:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource DbxAccent}" />
    </Style>
    <Style Selector="TextBlock.optdesc">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource DbxTextDim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <views:DialogFooter DockPanel.Dock="Bottom">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{Binding OkText}" Classes="accent" IsDefault="True" Click="OnOkClick" MinWidth="104" HorizontalContentAlignment="Center" />
        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" MinWidth="88" HorizontalContentAlignment="Center" />
      </StackPanel>
    </views:DialogFooter>

    <views:DialogHeader DockPanel.Dock="Top" Icon="{StaticResource IconDatabase}" Title="{Binding Title}"
                        Subtitle="Passwords are stored encrypted for your Windows user." />

    <!-- Scrolls when the screen is shorter than the form (the window caps its own height, see the code-behind) -->
    <ScrollViewer Background="{DynamicResource DbxContentBg}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Padding="24,20,24,22">
      <StackPanel Spacing="18">

        <!-- Engine: three cards, the form below follows the choice -->
        <ListBox x:Name="EngineList" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Background="Transparent"
                 BorderThickness="0" Padding="0" Margin="0,0,-8,0" AutomationProperties.Name="Database engine"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="model:DbKind">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <views:EngineIcon Kind="{Binding .}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ., Converter={x:Static views:Icons.EngineName}}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="GENERAL" Margin="0" />

          <Grid ColumnDefinitions="92,*">
            <Label Classes="cap" Content="_Name" Target="{Binding #NameBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBox x:Name="NameBox" Text="{Binding Name}" Watermark="e.g. Billing replica"
                       Classes.error="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="fielderror" Text="{Binding NameError}"
                         IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="92,*">
            <Label Classes="cap" Content="_Folder" Target="{Binding #FolderBox}" />
            <ComboBox x:Name="FolderBox" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding SelectedFolderChoice}" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="CONNECTION" Margin="0" />

          <Grid ColumnDefinitions="92,*" IsVisible="{Binding IsNetwork}">
            <Label Classes="cap" Content="_Host" Target="{Binding #HostBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <Grid ColumnDefinitions="*,Auto,96">
                <TextBox x:Name="HostBox" Text="{Binding Host}" Watermark="server.example.com"
                         Classes.error="{Binding HostError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Grid.Column="1" Classes="dim" Text="Port" Margin="14,0,8,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Text="{Binding PortText}" AutomationProperties.Name="Port"
                         Classes.error="{Binding PortError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Grid>
              <TextBlock Classes="fielderror" Text="{Binding HostError}"
                         IsVisible="{Binding HostError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="fielderror" Text="{Binding PortError}"
                         IsVisible="{Binding PortError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="92,*">
            <Label Classes="cap" Content="{Binding DatabaseLabel}" Target="{Binding #DatabaseBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="DatabaseBox" Text="{Binding Database}" Watermark="{Binding DatabasePlaceholder}"
                         Classes.error="{Binding DatabaseError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" IsVisible="{Binding IsSqlite}" Click="OnBrowseClick"
                        ToolTip.Tip="Choose a SQLite database file" />
              </Grid>
              <TextBlock Classes="fielderror" Text="{Binding DatabaseError}"
                         IsVisible="{Binding DatabaseError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="92,*" IsVisible="{Binding IsNetwork}">
            <Label Classes="cap" Content="_User" Target="{Binding #UserBox}" />
            <TextBox x:Name="UserBox" Grid.Column="1" Text="{Binding User}" />
          </Grid>

          <Grid ColumnDefinitions="92,*" IsVisible="{Binding IsNetwork}">
            <Label Classes="cap" Content="_Password" Target="{Binding #PasswordBox}" />
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" Watermark="{Binding PasswordHint}">
                <TextBox.InnerRightContent>
                  <ToggleButton x:Name="RevealButton" Classes="reveal" Content="Show" Click="OnRevealClick"
                                AutomationProperties.Name="Show password" ToolTip.Tip="Show or hide the password" />
                </TextBox.InnerRightContent>
              </TextBox>
              <CheckBox Content="Remove the saved password" IsChecked="{Binding ClearSavedPassword}"
                        IsVisible="{Binding HasSavedPassword}" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="OPTIONS" Margin="0" />
          <CheckBox IsChecked="{Binding Encrypt}" IsVisible="{Binding IsSqlServer}">
            <StackPanel>
              <TextBlock Text="Encrypt connection" />
              <TextBlock Classes="optdesc" Text="Uses TLS between this app and the server." />
            </StackPanel>
          </CheckBox>
          <CheckBox IsChecked="{Binding TrustServerCertificate}" IsVisible="{Binding IsSqlServer}" IsEnabled="{Binding Encrypt}"
                    ToolTip.Tip="Turn on Encrypt connection first" ToolTip.ShowOnDisabled="True">
            <StackPanel>
              <TextBlock Text="Trust server certificate" />
              <TextBlock Classes="optdesc" Text="Skips certificate validation. Use it for self-signed servers only." />
            </StackPanel>
          </CheckBox>
          <CheckBox IsChecked="{Binding ReadOnly}">
            <StackPanel>
              <TextBlock Text="Read-only" />
              <TextBlock Classes="optdesc" Text="Blocks row edits and write statements in scripts." />
            </StackPanel>
          </CheckBox>
        </StackPanel>

        <!-- Test connection -->
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="TestButton" Command="{Binding TestConnectionCommand}" AutomationProperties.Name="Test connection">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" Foreground="{DynamicResource DbxRun}" />
                <TextBlock Text="Test connection" />
              </StackPanel>
            </Button>
            <PathIcon Classes="spin" Data="{StaticResource IconRefresh}" Width="14" Height="14" VerticalAlignment="Center"
                      Foreground="{DynamicResource DbxAccent}" IsVisible="{Binding IsTesting}" />
            <TextBlock Classes="dim" Text="Testing…" VerticalAlignment="Center" IsVisible="{Binding IsTesting}" />
            <Button Content="Cancel test" Classes="subtle" Command="{Binding CancelTestCommand}" IsVisible="{Binding IsTesting}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding !IsTesting}">
            <Border Classes="banner" CornerRadius="6" BorderThickness="1" Classes.success="{Binding TestSucceeded}"
                    Classes.error="{Binding !TestSucceeded}" IsVisible="{Binding HasTestMessage}">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Classes="bi" Data="{StaticResource IconCheck}" IsVisible="{Binding TestSucceeded}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <PathIcon Classes="bi" Data="{StaticResource IconError}" IsVisible="{Binding !TestSucceeded}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding TestMessage}" TextWrapping="Wrap" />
              </Grid>
            </Border>
          </StackPanel>
          <Border Classes="banner error" CornerRadius="6" BorderThickness="1" IsVisible="{Binding HasGeneralError}">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Classes="bi" Data="{StaticResource IconError}" VerticalAlignment="Top" Margin="0,2,8,0" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
