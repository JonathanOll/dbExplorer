<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbExplorer.App.ViewModels"
        xmlns:views="using:DbExplorer.App.Views"
        xmlns:model="using:DbExplorer.Core.Model"
        x:Class="DbExplorer.App.Views.ConnectionDialog"
        x:DataType="vm:ConnectionDialogViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- Field captions: dim, top aligned with the text of a 32 px box so an error line under the box never moves them -->
    <Style Selector="Label.cap">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,7,12,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Foreground" Value="{DynamicResource DbxTextDim}" />
    </Style>
    <!-- "Show" / "Hide" inside the password box -->
    <Style Selector="ToggleButton.reveal">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource DbxTextDim}" />
    </Style>
    <Style Selector="ToggleButton.reveal:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource DbxAccent}" />
    </Style>
    <Style Selector="TextBlock.optdesc">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource DbxTextDim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <views:DialogFooter DockPanel.Dock="Bottom">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="{Binding OkText}" Classes="accent" IsDefault="True" Click="OnOkClick" MinWidth="104" HorizontalContentAlignment="Center" />
        <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" MinWidth="88" HorizontalContentAlignment="Center" />
      </StackPanel>
    </views:DialogFooter>

    <views:DialogHeader DockPanel.Dock="Top" Icon="{StaticResource IconDatabase}" Title="{Binding Title}"
                        Subtitle="Passwords and secrets are stored encrypted for your Windows user." />

    <!-- Scrolls when the screen is shorter than the form (the window caps its own height, see the code-behind) -->
    <ScrollViewer Background="{DynamicResource DbxContentBg}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Padding="24,20,24,22">
      <StackPanel Spacing="18">

        <!-- Engine: one card each, the form below follows the choice -->
        <ListBox x:Name="EngineList" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Background="Transparent"
                 BorderThickness="0" Padding="0" Margin="0,0,-8,0" AutomationProperties.Name="Database engine"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="model:DbKind">
              <!-- Icon above the name: four cards side by side leave no room for both on one line -->
              <StackPanel HorizontalAlignment="Center" Spacing="6">
                <views:EngineIcon Kind="{Binding .}" Width="18" Height="18" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ., Converter={x:Static views:Icons.EngineName}}" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="GENERAL" Margin="0" />

          <Grid ColumnDefinitions="92,*">
            <Label Classes="cap" Content="_Name" Target="{Binding #NameBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBox x:Name="NameBox" Text="{Binding Name}" Watermark="e.g. Billing replica"
                       Classes.error="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="fielderror" Text="{Binding NameError}"
                         IsVisible="{Binding NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="92,*">
            <Label Classes="cap" Content="_Folder" Target="{Binding #FolderBox}" />
            <ComboBox x:Name="FolderBox" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding FolderChoices}" SelectedItem="{Binding SelectedFolderChoice}" />
          </Grid>

          <Grid ColumnDefinitions="92,*">
            <Label Classes="cap" Content="En_vironment" Target="{Binding #EnvironmentBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <ComboBox x:Name="EnvironmentBox" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="model:DbEnvironment">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding ., Converter={x:Static views:Icons.EnvironmentName}}" VerticalAlignment="Center" />
                      <views:EnvironmentBadge Environment="{Binding .}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="optdesc" Text="On Production, every write asks for confirmation first." />
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="CONNECTION" Margin="0" />

          <Grid ColumnDefinitions="92,*" IsVisible="{Binding IsNetwork}">
            <Label Classes="cap" Content="_Host" Target="{Binding #HostBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <Grid ColumnDefinitions="*,Auto,96">
                <TextBox x:Name="HostBox" Text="{Binding Host}" Watermark="server.example.com"
                         Classes.error="{Binding HostError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Grid.Column="1" Classes="dim" Text="Port" Margin="14,0,8,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Text="{Binding PortText}" AutomationProperties.Name="Port"
                         Classes.error="{Binding PortError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Grid>
              <TextBlock Classes="fielderror" Text="{Binding HostError}"
                         IsVisible="{Binding HostError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="fielderror" Text="{Binding PortError}"
                         IsVisible="{Binding PortError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="92,*">
            <Label Classes="cap" Content="{Binding DatabaseLabel}" Target="{Binding #DatabaseBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="DatabaseBox" Text="{Binding Database}" Watermark="{Binding DatabasePlaceholder}"
                         Classes.error="{Binding DatabaseError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" IsVisible="{Binding IsSqlite}" Click="OnBrowseClick"
                        ToolTip.Tip="Choose a SQLite database file" />
              </Grid>
              <TextBlock Classes="fielderror" Text="{Binding DatabaseError}"
                         IsVisible="{Binding DatabaseError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="92,*" IsVisible="{Binding IsNetwork}">
            <Label Classes="cap" Content="_Sign in" Target="{Binding #AuthBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <ComboBox x:Name="AuthBox" HorizontalAlignment="Stretch" ItemsSource="{Binding AuthOptions}"
                        SelectedItem="{Binding SelectedAuthOption}" AutomationProperties.Name="Authentication">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AuthOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="optdesc" Text="{Binding AuthHint}" IsVisible="{Binding HasAuthHint}" />
              <TextBlock Classes="fielderror" Text="{Binding AuthError}" TextWrapping="Wrap"
                         IsVisible="{Binding AuthError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="92,*" IsVisible="{Binding ShowUser}">
            <Label Classes="cap" Content="{Binding UserLabel}" Target="{Binding #UserBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBox x:Name="UserBox" Text="{Binding User}" Watermark="{Binding UserPlaceholder}"
                       Classes.error="{Binding UserError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="fielderror" Text="{Binding UserError}"
                         IsVisible="{Binding UserError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="92,*" IsVisible="{Binding ShowPassword}">
            <Label Classes="cap" Content="{Binding PasswordLabel}" Target="{Binding #PasswordBox}" />
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" Watermark="{Binding PasswordHint}">
                <TextBox.InnerRightContent>
                  <ToggleButton x:Name="RevealButton" Classes="reveal" Content="Show" Click="OnRevealClick"
                                AutomationProperties.Name="Show password" ToolTip.Tip="Show or hide the password" />
                </TextBox.InnerRightContent>
              </TextBox>
              <CheckBox Content="Remove the saved password" IsChecked="{Binding ClearSavedPassword}"
                        IsVisible="{Binding HasSavedPassword}" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- TLS (PostgreSQL, MySQL / MariaDB): the mode, then only the files that mode can use -->
        <StackPanel x:Name="TlsSection" Spacing="12" IsVisible="{Binding ShowTls}">
          <TextBlock Classes="section" Text="TLS" Margin="0" />

          <Grid ColumnDefinitions="92,*">
            <Label Classes="cap" Content="SSL _mode" Target="{Binding #TlsModeBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <ComboBox x:Name="TlsModeBox" HorizontalAlignment="Stretch" ItemsSource="{Binding TlsModes}"
                        SelectedItem="{Binding TlsMode}" AutomationProperties.Name="SSL mode" />
              <TextBlock Classes="optdesc" Text="{Binding TlsHint}" />
            </StackPanel>
          </Grid>

          <Border x:Name="TlsWarningBanner" Classes="banner warn" CornerRadius="6" BorderThickness="1" Margin="92,0,0,0"
                  IsVisible="{Binding HasTlsWarning}">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Classes="bi" Data="{StaticResource IconWarning}" VerticalAlignment="Top" Margin="0,2,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding TlsWarning}" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="92,*" IsVisible="{Binding ShowRootCertificate}">
            <Label Classes="cap" Content="Root C_A" Target="{Binding #TlsRootBox}" />
            <StackPanel Grid.Column="1" Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="TlsRootBox" Text="{Binding TlsRootFile}" Watermark="Optional: ca.crt (PEM)"
                         AutomationProperties.Name="Root CA file" />
                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Tag="root" Click="OnBrowseCertificateClick"
                        ToolTip.Tip="Choose the CA certificate that signed the server's" />
              </Grid>
              <TextBlock Classes="optdesc" Text="{Binding TlsRootHint}" />
            </StackPanel>
          </Grid>

          <CheckBox x:Name="ClientCertificateCheck" Margin="92,0,0,0" IsChecked="{Binding UseClientCertificate}"
                    IsVisible="{Binding ShowClientCertificateChoice}" Content="Sign in with a client certificate" />

          <StackPanel Spacing="12" IsVisible="{Binding ShowClientCertificate}">
            <Grid ColumnDefinitions="92,*">
              <Label Classes="cap" Content="Certificate" Target="{Binding #TlsCertificateBox}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="TlsCertificateBox" Text="{Binding TlsCertificateFile}" Watermark="client.crt (PEM) or client.pfx"
                           AutomationProperties.Name="Client certificate file"
                           Classes.error="{Binding TlsCertificateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Tag="certificate" Click="OnBrowseCertificateClick"
                          ToolTip.Tip="Choose the client certificate file" />
                </Grid>
                <TextBlock Classes="fielderror" Text="{Binding TlsCertificateError}"
                           IsVisible="{Binding TlsCertificateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="92,*">
              <Label Classes="cap" Content="Key file" Target="{Binding #TlsKeyBox}" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <TextBox x:Name="TlsKeyBox" Text="{Binding TlsKeyFile}" Watermark="client.key; empty if in the certificate file"
                         AutomationProperties.Name="Client key file" />
                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Tag="key" Click="OnBrowseCertificateClick"
                        ToolTip.Tip="Choose the private key of the client certificate" />
              </Grid>
            </Grid>

            <Grid ColumnDefinitions="92,*">
              <Label Classes="cap" Content="Passphrase" Target="{Binding #TlsPassphraseBox}" />
              <TextBox x:Name="TlsPassphraseBox" Grid.Column="1" Text="{Binding TlsPassphrase}" PasswordChar="•"
                       Watermark="{Binding TlsPassphraseHint}" AutomationProperties.Name="Client key passphrase" />
            </Grid>
          </StackPanel>
        </StackPanel>

        <!-- SSH tunnel: one check box until it is wanted -->
        <StackPanel Spacing="12" IsVisible="{Binding IsNetwork}">
          <TextBlock Classes="section" Text="SSH TUNNEL" Margin="0" />
          <CheckBox x:Name="SshCheck" IsChecked="{Binding UseSsh}">
            <StackPanel>
              <TextBlock Text="Connect through an SSH tunnel" />
              <TextBlock Classes="optdesc" Text="The database host and port above are then reached from the SSH server." />
            </StackPanel>
          </CheckBox>
          <StackPanel Spacing="12" IsVisible="{Binding ShowSsh}">
            <Grid ColumnDefinitions="92,*">
              <Label Classes="cap" Content="SS_H host" Target="{Binding #SshHostBox}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <Grid ColumnDefinitions="*,Auto,96">
                  <TextBox x:Name="SshHostBox" Text="{Binding SshHost}" Watermark="jump.example.com"
                           Classes.error="{Binding SshHostError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Grid.Column="1" Classes="dim" Text="Port" Margin="14,0,8,0" VerticalAlignment="Center" />
                  <TextBox x:Name="SshPortBox" Grid.Column="2" Text="{Binding SshPortText}" AutomationProperties.Name="SSH port"
                           Classes.error="{Binding SshPortError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>
                <TextBlock Classes="fielderror" Text="{Binding SshHostError}"
                           IsVisible="{Binding SshHostError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="fielderror" Text="{Binding SshPortError}"
                           IsVisible="{Binding SshPortError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="92,*">
              <Label Classes="cap" Content="SSH us_er" Target="{Binding #SshUserBox}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBox x:Name="SshUserBox" Text="{Binding SshUser}"
                         Classes.error="{Binding SshUserError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="fielderror" Text="{Binding SshUserError}"
                           IsVisible="{Binding SshUserError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="92,*">
              <Label Classes="cap" Content="SSH sign in" Target="{Binding #SshAuthBox}" />
              <ComboBox x:Name="SshAuthBox" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding SshAuthChoices}"
                        SelectedIndex="{Binding SshAuthIndex}" AutomationProperties.Name="SSH authentication" />
            </Grid>

            <Grid ColumnDefinitions="92,*" IsVisible="{Binding IsSshPassword}">
              <Label Classes="cap" Content="Password" Target="{Binding #SshPasswordBox}" />
              <TextBox x:Name="SshPasswordBox" Grid.Column="1" Text="{Binding SshPassword}" PasswordChar="•"
                       Watermark="{Binding SshPasswordHint}" AutomationProperties.Name="SSH password" />
            </Grid>

            <Grid ColumnDefinitions="92,*" IsVisible="{Binding IsSshKey}">
              <Label Classes="cap" Content="_Key file" Target="{Binding #SshKeyBox}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="SshKeyBox" Text="{Binding SshKeyFile}" Watermark="%USERPROFILE%\.ssh\id_ed25519"
                           Classes.error="{Binding SshKeyError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseKeyClick"
                          ToolTip.Tip="Choose a private key file" />
                </Grid>
                <TextBlock Classes="fielderror" Text="{Binding SshKeyError}"
                           IsVisible="{Binding SshKeyError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="92,*" IsVisible="{Binding IsSshKey}">
              <Label Classes="cap" Content="Passphrase" Target="{Binding #SshPassphraseBox}" />
              <TextBox x:Name="SshPassphraseBox" Grid.Column="1" Text="{Binding SshPassphrase}" PasswordChar="•"
                       Watermark="{Binding SshPassphraseHint}" AutomationProperties.Name="Private key passphrase" />
            </Grid>

            <TextBlock Classes="optdesc" Margin="92,0,0,0"
                       Text="The first connection shows the server's key fingerprint for you to check. A changed key is refused." />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="OPTIONS" Margin="0" />
          <CheckBox IsChecked="{Binding Encrypt}" IsVisible="{Binding IsSqlServer}">
            <StackPanel>
              <TextBlock Text="Encrypt connection" />
              <TextBlock Classes="optdesc" Text="Uses TLS between this app and the server." />
            </StackPanel>
          </CheckBox>
          <CheckBox IsChecked="{Binding TrustServerCertificate}" IsVisible="{Binding IsSqlServer}" IsEnabled="{Binding Encrypt}"
                    ToolTip.Tip="Turn on Encrypt connection first" ToolTip.ShowOnDisabled="True">
            <StackPanel>
              <TextBlock Text="Trust server certificate" />
              <TextBlock Classes="optdesc" Text="Skips certificate validation. Use it for self-signed servers only." />
            </StackPanel>
          </CheckBox>
          <CheckBox IsChecked="{Binding ReadOnly}">
            <StackPanel>
              <TextBlock Text="Read-only" />
              <TextBlock Classes="optdesc" Text="Blocks row edits and write statements in scripts." />
            </StackPanel>
          </CheckBox>
        </StackPanel>

        <!-- Test connection -->
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="TestButton" Command="{Binding TestConnectionCommand}" AutomationProperties.Name="Test connection">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" Foreground="{DynamicResource DbxRun}" />
                <TextBlock Text="Test connection" />
              </StackPanel>
            </Button>
            <PathIcon Classes="spin" Data="{StaticResource IconRefresh}" Width="14" Height="14" VerticalAlignment="Center"
                      Foreground="{DynamicResource DbxAccent}" IsVisible="{Binding IsTesting}" />
            <TextBlock Classes="dim" Text="Testing…" VerticalAlignment="Center" IsVisible="{Binding IsTesting}" />
            <Button Content="Cancel test" Classes="subtle" Command="{Binding CancelTestCommand}" IsVisible="{Binding IsTesting}" />
          </StackPanel>
          <StackPanel IsVisible="{Binding !IsTesting}">
            <Border Classes="banner" CornerRadius="6" BorderThickness="1" Classes.success="{Binding TestSucceeded}"
                    Classes.error="{Binding !TestSucceeded}" IsVisible="{Binding HasTestMessage}">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Classes="bi" Data="{StaticResource IconCheck}" IsVisible="{Binding TestSucceeded}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <PathIcon Classes="bi" Data="{StaticResource IconError}" IsVisible="{Binding !TestSucceeded}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding TestMessage}" TextWrapping="Wrap" />
              </Grid>
            </Border>
          </StackPanel>
          <Border Classes="banner error" CornerRadius="6" BorderThickness="1" IsVisible="{Binding HasGeneralError}">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Classes="bi" Data="{StaticResource IconError}" VerticalAlignment="Top" Margin="0,2,8,0" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
