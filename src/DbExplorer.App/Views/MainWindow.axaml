<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbExplorer.App.ViewModels"
        xmlns:views="using:DbExplorer.App.Views"
        xmlns:model="using:DbExplorer.Core.Model"
        x:Class="DbExplorer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="720" MinHeight="420">

  <Window.Resources>
    <!-- The document tab strip of the foundation, plus a "new script" button at its right end -->
    <ControlTheme x:Key="MainDocTabControl" TargetType="TabControl" BasedOn="{StaticResource DbxDocTabControl}">
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel Background="{TemplateBinding Background}">
            <Border DockPanel.Dock="Top" Background="{DynamicResource DbxTabStripBg}">
              <Grid ColumnDefinitions="*,Auto">
                <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource DbxBorderSubtle}" />
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="6,0,0,0" />
                <Button Grid.Column="1" Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconAdd}" Margin="2,0,6,2" MinWidth="28" MinHeight="28"
                        Padding="4" Command="{Binding NewScriptTabCommand, DataType=vm:MainViewModel}"
                        AutomationProperties.Name="New SQL script" ToolTip.Tip="New SQL script (Ctrl+N)" />
              </Grid>
            </Border>
            <ContentPresenter Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <!-- tab close button: only drawn (and clickable) on the hovered or the selected tab -->
    <Style Selector="TabItem Button.close">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="TabItem:pointerover Button.close, TabItem:selected Button.close">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <!-- the unsaved dot steps aside while the pointer is on the tab (the close button takes its place) -->
    <Style Selector="TabItem:pointerover Ellipse.dirty"><Setter Property="Opacity" Value="0" /></Style>
    <!-- status bar severities -->
    <Style Selector="PathIcon.status"><Setter Property="Foreground" Value="{DynamicResource DbxInfo}" /></Style>
    <Style Selector="PathIcon.status.success"><Setter Property="Foreground" Value="{DynamicResource DbxSuccess}" /></Style>
    <Style Selector="PathIcon.status.warn"><Setter Property="Foreground" Value="{DynamicResource DbxWarn}" /></Style>
    <Style Selector="PathIcon.status.error"><Setter Property="Foreground" Value="{DynamicResource DbxError}" /></Style>
    <!-- a welcome card that waits for a connection reads as unavailable (its tooltip says why) -->
    <Style Selector="Button.card:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    <Style Selector="TextBlock.statusText.error"><Setter Property="Foreground" Value="{DynamicResource DbxError}" /></Style>
    <!-- navigator drop target while a connection is dragged -->
    <Style Selector="TreeViewItem.drop /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource DbxAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DbxAccent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>

  <Grid>
    <DockPanel>
      <!-- Menu bar: everything the app does, in the usual places (the shortcuts are shown, Alt+letter opens a menu) -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource DbxWindowBg}" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,0,0,1">
        <Menu x:Name="MainMenu" Padding="4,0" AutomationProperties.Name="Main menu">
          <MenuItem Header="_File">
            <MenuItem Header="_New SQL script" Command="{Binding NewScriptTabCommand}" InputGesture="Ctrl+N" />
            <MenuItem Header="_Open script file…" Command="{Binding OpenScriptFileCommand}" InputGesture="Ctrl+O" />
            <MenuItem Header="_Save script" Command="{Binding ActiveScript.SaveCommand, FallbackValue={x:Null}}" IsEnabled="{Binding HasActiveScript}" InputGesture="Ctrl+S"
                      ToolTip.Tip="{Binding ScriptMenuTip}" ToolTip.ShowOnDisabled="True" />
            <MenuItem Header="Save script _as…" Command="{Binding SaveScriptAsCommand}" IsEnabled="{Binding HasActiveScript}"
                      ToolTip.Tip="{Binding SaveAsMenuTip}" ToolTip.ShowOnDisabled="True" />
            <Separator />
            <!-- the entries are built when the submenu opens (OnRecentMenuOpened); this one only makes it a submenu -->
            <MenuItem x:Name="RecentMenu" Header="Recent _scripts" SubmenuOpened="OnRecentMenuOpened">
              <MenuItem Header="No recent scripts" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="Open script _library folder" Command="{Binding OpenLibraryFolderCommand}"
                      ToolTip.Tip="Show the folder that holds the scripts of the navigator in the file manager" />
            <Separator />
            <MenuItem Header="_Close tab" Command="{Binding CloseActiveTabCommand}" InputGesture="Ctrl+W" />
            <MenuItem Header="_Reopen closed tab" Command="{Binding ReopenClosedTabCommand}" InputGesture="Ctrl+Shift+T" />
            <Separator />
            <MenuItem Header="E_xit" Click="OnExitMenuClick" InputGesture="Alt+F4" />
          </MenuItem>

          <MenuItem Header="_Connections" SubmenuOpened="OnConnectionsMenuOpened">
            <MenuItem Header="New _connection…" Command="{Binding Tree.AddConnectionCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconDatabaseAdd}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="New _folder…" Command="{Binding Tree.AddFolderCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconFolderAdd}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="New _group of databases…" Command="{Binding Tree.NewGroupCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconGroupAdd}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="_Import from DBeaver…" Command="{Binding Tree.ImportFromDBeaverCommand}">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconImport}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="_Refresh schema" Command="{Binding Tree.RefreshSelectedCommand}" InputGesture="F5" />
            <MenuItem Header="Collapse _all" Command="{Binding Tree.CollapseAllCommand}" />
            <Separator />
            <MenuItem Header="_Upgrade database…" Command="{Binding OpenUpgradeCommand}" />
            <Separator />
            <MenuItem Header="Open in _Claude Code" Command="{Binding OpenInClaudeCodeCommand}"
                      ToolTip.Tip="Open a terminal running Claude Code with the dbExplorer tools (set up in Settings, Claude Code)">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconConsole}" /></MenuItem.Icon>
            </MenuItem>
          </MenuItem>

          <MenuItem Header="_View">
            <MenuItem Header="Command _palette…" Command="{Binding ShowCommandPaletteCommand}" InputGesture="Ctrl+Shift+K">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconSearch}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="_Navigator" ToggleType="CheckBox" IsChecked="{Binding IsNavigatorVisible, Mode=OneWay}" Command="{Binding ToggleNavigatorCommand}" InputGesture="Ctrl+B" />
            <MenuItem Header="Show active item in _navigator" Command="{Binding RevealActiveTabCommand}" />
            <MenuItem Header="Show _folders" ToggleType="CheckBox" IsChecked="{Binding Tree.ShowFolders, Mode=OneWay}" Command="{Binding Tree.ToggleFoldersCommand}"
                      ToolTip.Tip="Off: the connections are listed flat, without their folders" />
            <MenuItem Header="Show _groups" ToggleType="CheckBox" IsChecked="{Binding Tree.ShowGroups, Mode=OneWay}" Command="{Binding Tree.ToggleGroupsCommand}" />
            <MenuItem Header="Show _scripts" ToggleType="CheckBox" IsChecked="{Binding Tree.ShowScripts, Mode=OneWay}" Command="{Binding Tree.ToggleScriptsCommand}"
                      ToolTip.Tip="The script library: your saved scripts and their folders" />
            <Separator />
            <MenuItem Header="Query _history…" Command="{Binding OpenHistoryCommand}" InputGesture="Ctrl+Shift+H">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconHistory}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Go to _table…" Command="{Binding ShowTablePickerCommand}" InputGesture="Ctrl+T" />
            <MenuItem Header="Go to table in _all connections…" Command="{Binding ShowAllTablesPickerCommand}" InputGesture="Ctrl+Shift+P" />
            <MenuItem Header="Go to _column…" Command="{Binding JumpToColumnCommand}" IsEnabled="{Binding HasActiveTable}" InputGesture="Ctrl+L"
                      ToolTip.Tip="{Binding TableMenuTip}" ToolTip.ShowOnDisabled="True" />
            <MenuItem Header="Search in scripts and _data…" Command="{Binding ShowSearchCommand}" InputGesture="Ctrl+Alt+F">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconSearch}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Ne_xt tab" Command="{Binding NextTabCommand}" InputGesture="Ctrl+Tab" />
            <MenuItem Header="_Previous tab" Command="{Binding PreviousTabCommand}" InputGesture="Ctrl+Shift+Tab" />
          </MenuItem>

          <MenuItem Header="_Script">
            <MenuItem Header="_Run statement" Command="{Binding ActiveScript.RunStatementCommand, FallbackValue={x:Null}}" IsEnabled="{Binding HasActiveScript}" InputGesture="Ctrl+Enter"
                      ToolTip.Tip="{Binding ScriptMenuTip}" ToolTip.ShowOnDisabled="True" />
            <MenuItem Header="Run _all" Command="{Binding ActiveScript.RunScriptCommand, FallbackValue={x:Null}}" IsEnabled="{Binding HasActiveScript}" InputGesture="F5"
                      ToolTip.Tip="{Binding ScriptMenuTip}" ToolTip.ShowOnDisabled="True" />
            <MenuItem Header="S_top" Command="{Binding ActiveScript.CancelCommand, FallbackValue={x:Null}}" IsEnabled="{Binding HasActiveScript}" InputGesture="Escape"
                      ToolTip.Tip="{Binding ScriptMenuTip}" ToolTip.ShowOnDisabled="True" />
            <Separator />
            <MenuItem Header="_Format SQL" Command="{Binding ActiveScript.FormatSqlCommand, FallbackValue={x:Null}}" IsEnabled="{Binding HasActiveScript}" InputGesture="Ctrl+Shift+F"
                      ToolTip.Tip="{Binding ScriptMenuTip}" ToolTip.ShowOnDisabled="True">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconFormat}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="_Estimated execution plan" Command="{Binding ActiveScript.ShowEstimatedPlanCommand, FallbackValue={x:Null}}" IsEnabled="{Binding HasActiveScript}" InputGesture="Ctrl+L"
                      ToolTip.Tip="{Binding ScriptMenuTip}" ToolTip.ShowOnDisabled="True" />
            <MenuItem Header="Include actual _plan" ToggleType="CheckBox" IsChecked="{Binding ActiveScript.ActualPlanEnabled, Mode=TwoWay, FallbackValue=False}"
                      IsEnabled="{Binding ActiveScript.CanUseActualPlan, FallbackValue=False}" InputGesture="Ctrl+M"
                      ToolTip.Tip="{Binding ActualPlanMenuTip}" ToolTip.ShowOnDisabled="True" />
            <MenuItem Header="Include _statistics (SQL Server)" ToggleType="CheckBox" IsChecked="{Binding ActiveScript.StatisticsEnabled, Mode=TwoWay, FallbackValue=False}"
                      IsEnabled="{Binding ActiveScript.CanUseStatistics, FallbackValue=False}"
                      ToolTip.Tip="{Binding StatisticsMenuTip}" ToolTip.ShowOnDisabled="True" />
          </MenuItem>

          <MenuItem Header="_Tools">
            <MenuItem Header="_Settings…" Command="{Binding OpenOptionsCommand}" InputGesture="Ctrl+OemComma">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconSettings}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Upgrade database…" Command="{Binding OpenUpgradeCommand}" />
          </MenuItem>

          <MenuItem Header="_Help">
            <MenuItem Header="_Keyboard shortcuts" Command="{Binding ShowShortcutsCommand}" InputGesture="F1">
              <MenuItem.Icon><PathIcon Data="{StaticResource IconKeyboard}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Check for _updates automatically" ToggleType="CheckBox" IsChecked="{Binding Update.AutoCheckEnabled, Mode=TwoWay}" />
          </MenuItem>
        </Menu>
      </Border>

      <!-- Config problem (read-only config mode): always visible, above everything -->
      <Border DockPanel.Dock="Top" Classes="banner error"
              IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <PathIcon Classes="bi" Data="{StaticResource IconError}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Theme="{StaticResource DbxToolButton}" Classes="close" Tag="{StaticResource IconClose}" MinWidth="22" MinHeight="22" Padding="4"
                  Command="{Binding DismissBannerCommand}" AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss for this session" />
        </Grid>
      </Border>

      <!-- While the background check runs (a second or two): a quiet info band, gone as soon as there is an answer -->
      <Border DockPanel.Dock="Top" Classes="banner info" IsVisible="{Binding Update.IsChecking}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Classes="bi spin" Data="{StaticResource IconRefresh}" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock Text="Checking for updates…" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- New version: info band with "Update and restart" / "Later"; red with the reason when the update failed (Retry / Dismiss) -->
      <Border DockPanel.Dock="Top" Classes="banner" Classes.info="{Binding !Update.IsFailed}" Classes.error="{Binding Update.IsFailed}"
              IsVisible="{Binding Update.IsVisible}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <PathIcon Classes="bi" Data="{StaticResource IconInfo}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Update.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <ProgressBar Grid.Column="2" Classes="thin" Minimum="0" Maximum="1" Value="{Binding Update.Progress}" Width="120" Margin="8,0,0,0"
                       VerticalAlignment="Center" IsVisible="{Binding Update.IsDownloading}" />
          <Button Grid.Column="3" Theme="{StaticResource DbxToolButton}" Classes="accent" Tag="{StaticResource IconImport}" Margin="12,0,0,0"
                  Content="{Binding Update.ActionText}" Command="{Binding Update.UpdateCommand}" IsVisible="{Binding Update.CanAct}" />
          <Button Grid.Column="4" Theme="{StaticResource DbxToolButton}" Margin="4,0,0,0"
                  Content="{Binding Update.DismissText}" Command="{Binding Update.DismissCommand}" IsVisible="{Binding Update.CanAct}" />
        </Grid>
      </Border>

      <!-- Status bar: message with its history (left), the running operation, the active connection, shortcuts and settings (right) -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource DbxWindowBg}" BorderBrush="{DynamicResource DbxBorderSubtle}"
              BorderThickness="0,1,0,0" MinHeight="30" Padding="6,0,6,0">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <!-- last message: click for the history of the session; warnings and errors stay until dismissed -->
          <Grid Grid.Column="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <Button Classes="ghost" Padding="6,2" MinHeight="24" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalAlignment="Center"
                    IsVisible="{Binding Status.ShowMessage}" ToolTip.Tip="{Binding Status.Message}"
                    AutomationProperties.Name="Last message, click for the history" MaxWidth="900">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Classes="status" Classes.success="{Binding Status.IsSuccess}" Classes.warn="{Binding Status.IsWarn}"
                          Classes.error="{Binding Status.IsError}" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"
                          Data="{Binding Status.Severity, Converter={x:Static views:StatusIcons.Severity}}" />
                <TextBlock Grid.Column="1" Classes="statusText" Classes.error="{Binding Status.IsError}" Text="{Binding Status.Message}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="{DynamicResource DbxSmallFontSize}" />
              </Grid>
              <Button.Flyout>
                <Flyout Placement="Top">
                  <StackPanel Width="420" Spacing="6">
                    <TextBlock Classes="title" Text="Recent messages" />
                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding Status.History}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StatusEntry">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,3">
                              <PathIcon Classes="status" Classes.success="{Binding IsSuccess}" Classes.warn="{Binding IsWarn}" Classes.error="{Binding IsError}"
                                        Width="13" Height="13" Margin="0,2,8,0" VerticalAlignment="Top"
                                        Data="{Binding Severity, Converter={x:Static views:StatusIcons.Severity}}" />
                              <TextBlock Grid.Column="1" Classes="faint small" Text="{Binding TimeText}" Margin="0,1,10,0" VerticalAlignment="Top" />
                              <SelectableTextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontSize="{DynamicResource DbxSmallFontSize}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button Grid.Column="1" Theme="{StaticResource DbxToolButton}" Classes="close" Tag="{StaticResource IconClose}" MinWidth="22" MinHeight="22" Padding="4"
                    Command="{Binding Status.DismissCommand}" IsVisible="{Binding Status.IsSticky}"
                    AutomationProperties.Name="Dismiss the message" ToolTip.Tip="Dismiss" />
          </Grid>

          <!-- a running operation replaces the message; Cancel only when the operation can be cancelled -->
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center" Margin="8,0"
                IsVisible="{Binding Status.IsBusy}">
            <ProgressBar Classes="thin" IsIndeterminate="{Binding Status.IsBusy}" Width="90" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="dim small" Text="{Binding Status.BusyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconClose}" Content="Cancel" MinHeight="24"
                    Command="{Binding Status.CancelBusyCommand}" IsVisible="{Binding Status.CanCancel}"
                    ToolTip.Tip="Cancel this operation" AutomationProperties.Name="Cancel the running operation" />
          </Grid>

          <!-- the connection the next action works on: state dot, name, engine, read-only -->
          <Border Grid.Column="1" Padding="8,0" VerticalAlignment="Center" Background="Transparent"
                  DataContext="{Binding CurrentConnectionNode}" x:DataType="vm:ConnectionNodeViewModel"
                  IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding StateText}">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource DbxSuccess}" IsVisible="{Binding IsConnected}" />
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource DbxError}" IsVisible="{Binding HasError}" />
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="Transparent" Stroke="{DynamicResource DbxBorderStrong}" StrokeThickness="1.5"
                       IsVisible="{Binding IsDisconnected}" />
              <PathIcon Classes="spin" Data="{StaticResource IconRefresh}" Width="12" Height="12" Foreground="{DynamicResource DbxAccent}"
                        IsVisible="{Binding IsConnecting}" />
              <TextBlock Classes="small" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Classes="dim small" VerticalAlignment="Center"
                         Text="{Binding Config.Kind, Converter={x:Static views:Icons.EngineName}}" />
              <views:EnvironmentBadge Environment="{Binding ConnectionEnvironment}" />
              <Border Classes="badge warn" IsVisible="{Binding IsReadOnly}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <PathIcon Data="{StaticResource IconLock}" Width="10" Height="10" />
                  <TextBlock Text="Read-only" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Border Classes="vsep" Margin="2,8" />
            <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconKeyboard}" MinWidth="28" MinHeight="26" Padding="4,0"
                    Command="{Binding ShowShortcutsCommand}" AutomationProperties.Name="Keyboard shortcuts">
              <ToolTip.Tip>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Keyboard shortcuts" />
                  <Border Classes="kbd"><TextBlock Text="F1" /></Border>
                </StackPanel>
              </ToolTip.Tip>
            </Button>
            <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconSettings}" MinWidth="28" MinHeight="26" Padding="4,0"
                    ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedRight" Opening="OnSettingsFlyoutOpening">
                  <MenuItem Header="Upgrade database…" Command="{Binding OpenUpgradeCommand}" />
                  <MenuItem Header="Settings…" Command="{Binding OpenOptionsCommand}" InputGesture="Ctrl+OemComma" />
                  <MenuItem Header="Keyboard shortcuts" Command="{Binding ShowShortcutsCommand}" InputGesture="F1" />
                  <Separator />
                  <MenuItem Header="Check for updates automatically" ToggleType="CheckBox"
                            IsChecked="{Binding Update.AutoCheckEnabled, Mode=TwoWay}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="304" MinWidth="220" MaxWidth="560" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Navigator: title strip with the + menu, refresh and collapse; a filter box; the tree (or its empty states) -->
        <Border Grid.Column="0" Background="{DynamicResource DbxNavBg}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="panelHeader">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Connections" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconAdd}" MinWidth="30" Padding="4,0"
                          ToolTip.Tip="Add a connection, folder or group" AutomationProperties.Name="Add">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="New connection…" Command="{Binding Tree.AddConnectionCommand}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource IconDatabaseAdd}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="New folder…" Command="{Binding Tree.AddFolderCommand}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource IconFolderAdd}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="New group of databases…" Command="{Binding Tree.NewGroupCommand}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource IconGroupAdd}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Import from DBeaver…" Command="{Binding Tree.ImportFromDBeaverCommand}">
                          <MenuItem.Icon><PathIcon Data="{StaticResource IconImport}" /></MenuItem.Icon>
                        </MenuItem>
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                  <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconRefresh}" Command="{Binding Tree.RefreshSelectedCommand}"
                          MinWidth="30" Padding="4,0" AutomationProperties.Name="Refresh schema">
                    <ToolTip.Tip>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Refresh the schema of the selected connection" />
                        <Border Classes="kbd"><TextBlock Text="F5" /></Border>
                      </StackPanel>
                    </ToolTip.Tip>
                  </Button>
                  <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconLocate}" Command="{Binding RevealActiveTabCommand}"
                          MinWidth="30" Padding="4,0" AutomationProperties.Name="Show the active item in the navigator">
                    <ToolTip.Tip>
                      <TextBlock Text="Show the active tab's item: expands the folders down to it and selects it" />
                    </ToolTip.Tip>
                  </Button>
                  <Button Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconCollapseAll}" Command="{Binding Tree.CollapseAllCommand}"
                          MinWidth="30" Padding="4,0" ToolTip.Tip="Collapse all" AutomationProperties.Name="Collapse all" />
                </StackPanel>
              </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Padding="8,8,8,4" IsVisible="{Binding !Tree.IsEmpty}">
              <TextBox x:Name="FilterBox" Text="{Binding Tree.FilterText, Mode=TwoWay}" Watermark="Filter connections, tables and scripts…"
                       AutomationProperties.Name="Filter the navigator">
                <TextBox.InnerRightContent>
                  <Button Theme="{StaticResource DbxToolButton}" Classes="close" Tag="{StaticResource IconClose}" MinWidth="22" MinHeight="22" Padding="4"
                          Command="{Binding Tree.ClearFilterCommand}" IsVisible="{Binding Tree.HasFilter}"
                          AutomationProperties.Name="Clear the filter" ToolTip.Tip="Clear the filter (Esc)" />
                </TextBox.InnerRightContent>
              </TextBox>
            </Border>

            <Panel>
              <TreeView x:Name="ConnectionTree" ItemsSource="{Binding Tree.Nodes}"
                        SelectedItem="{Binding Tree.SelectedNode, Mode=TwoWay}"
                        DragDrop.AllowDrop="True" Background="Transparent" Padding="2,4" AutomationProperties.Name="Connections"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsVisible" Value="{Binding IsShown}" />
                  </Style>
                </TreeView.Styles>

                <TreeView.DataTemplates>
                  <TreeDataTemplate DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
                      <Panel Width="16" Height="16" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" Foreground="{DynamicResource DbxIconFolder}"
                                  IsVisible="{Binding !IsExpanded}" />
                        <PathIcon Data="{StaticResource IconFolderOpen}" Width="15" Height="15" Foreground="{DynamicResource DbxIconFolder}"
                                  IsVisible="{Binding IsExpanded}" />
                      </Panel>
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Classes="faint small" VerticalAlignment="Center"
                                 Text="{Binding CountText}" />
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Rename…" Command="{Binding Tree.RenameFolderCommand}" CommandParameter="{Binding}" InputGesture="F2" />
                          <Separator />
                          <MenuItem Header="Set environment of its connections…" Command="{Binding Tree.SetFolderEnvironmentCommand}"
                                    CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="Move up" Command="{Binding Tree.MoveFolderUpCommand}" CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanMoveUp}" ToolTip.Tip="{Binding MoveUpTip}" ToolTip.ShowOnDisabled="True" />
                          <MenuItem Header="Move down" Command="{Binding Tree.MoveFolderDownCommand}" CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanMoveDown}" ToolTip.Tip="{Binding MoveDownTip}" ToolTip.ShowOnDisabled="True" />
                          <Separator />
                          <MenuItem Classes="danger" Header="Delete" Command="{Binding Tree.DeleteFolderCommand}" CommandParameter="{Binding}" InputGesture="Delete">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconDelete}" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                    </StackPanel>
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:ConnectionNodeViewModel" ItemsSource="{Binding Children}">
                    <Border Background="Transparent">
                      <views:ConnectionRow />
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Connect" Command="{Binding Tree.ConnectCommand}" CommandParameter="{Binding}" FontWeight="SemiBold"
                                    IsVisible="{Binding IsDisconnected}" InputGesture="Enter" />
                          <MenuItem Header="Retry connection" Command="{Binding Tree.ConnectCommand}" CommandParameter="{Binding}" FontWeight="SemiBold"
                                    IsVisible="{Binding HasError}" InputGesture="Enter" />
                          <MenuItem Header="Show the error" Command="{Binding Tree.ShowErrorCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasError}" />
                          <MenuItem Header="Disconnect" Command="{Binding Tree.DisconnectNodeCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsConnected}" />
                          <Separator />
                          <MenuItem Header="New SQL script" Command="{Binding Tree.NewScriptOnCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+N">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconScript}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Go to table…" Command="{Binding Tree.PickTableOnCommand}" CommandParameter="{Binding}" InputGesture="Ctrl+T">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconTable}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="ER diagram" Command="{Binding Tree.ShowDiagramCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconDiagram}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Refresh schema" Command="{Binding Tree.RefreshCommand}" CommandParameter="{Binding}" IsVisible="{Binding IsConnected}"
                                    InputGesture="F5">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="Add to group…" Command="{Binding Tree.AddToGroupCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconGroup}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Read-only" ToggleType="CheckBox" IsChecked="{Binding IsReadOnly, Mode=OneWay}"
                                    Command="{Binding Tree.ToggleReadOnlyCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Copy name" Click="OnCopyNodeName" />
                          <Separator />
                          <MenuItem Header="Edit…" Command="{Binding Tree.EditConnectionCommand}" CommandParameter="{Binding}" InputGesture="F2" />
                          <MenuItem Header="Duplicate" Command="{Binding Tree.DuplicateConnectionCommand}" CommandParameter="{Binding}" />
                          <MenuItem Classes="danger" Header="Delete" Command="{Binding Tree.DeleteConnectionCommand}" CommandParameter="{Binding}" InputGesture="Delete">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconDelete}" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </Border.ContextMenu>
                    </Border>
                  </TreeDataTemplate>

                  <!-- Groups: a section header, then one node per group, then shortcuts to the member connections -->
                  <TreeDataTemplate DataType="vm:GroupsSectionNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
                      <PathIcon Classes="dim" Data="{StaticResource IconGroup}" Width="15" Height="15" />
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Classes="faint small" VerticalAlignment="Center"
                                 Text="{Binding Children.Count, Converter={x:Static views:Icons.CountInParens}}" />
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="New group…" Command="{Binding Tree.NewGroupCommand}" />
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                    </StackPanel>
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:GroupNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
                      <PathIcon Classes="dim" Data="{StaticResource IconGroup}" Width="14" Height="14" />
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      <TextBlock Classes="faint small" Text="{Binding Summary}" VerticalAlignment="Center" />
                      <PathIcon Data="{StaticResource IconWarning}" Width="12" Height="12" Foreground="{DynamicResource DbxWarn}"
                                IsVisible="{Binding IsUnderPopulated}"
                                ToolTip.Tip="A group needs at least 2 databases to switch between them or compare them. Drag a connection onto it to add one." />
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Connect all" Command="{Binding Tree.ConnectGroupCommand}" CommandParameter="{Binding}" FontWeight="SemiBold" />
                          <Separator />
                          <MenuItem Header="Check schema differences" Command="{Binding Tree.CheckSchemaDifferencesCommand}" CommandParameter="{Binding Group}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconSchema}" /></MenuItem.Icon>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="Edit group…" Command="{Binding Tree.EditGroupCommand}" CommandParameter="{Binding Group}" />
                          <MenuItem Header="Rename…" Command="{Binding Tree.RenameGroupCommand}" CommandParameter="{Binding Group}" InputGesture="F2" />
                          <MenuItem Header="New group…" Command="{Binding Tree.NewGroupCommand}" />
                          <Separator />
                          <MenuItem Classes="danger" Header="Delete" Command="{Binding Tree.DeleteGroupCommand}" CommandParameter="{Binding Group}" InputGesture="Delete">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconDelete}" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                    </StackPanel>
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:GroupMemberNodeViewModel" ItemsSource="{Binding Children}">
                    <Border Background="Transparent">
                      <views:ConnectionRow DataContext="{Binding Target}" />
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Connect" Command="{Binding Tree.OpenGroupMemberCommand}" CommandParameter="{Binding}" FontWeight="SemiBold" />
                          <MenuItem Header="Remove from group" Command="{Binding Tree.RemoveMemberCommand}" CommandParameter="{Binding}" />
                        </ContextMenu>
                      </Border.ContextMenu>
                    </Border>
                  </TreeDataTemplate>

                  <!-- Scripts: the script library, real folders and .sql files -->
                  <TreeDataTemplate DataType="vm:ScriptsSectionNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
                      <PathIcon Classes="dim" Data="{StaticResource IconScript}" Width="15" Height="15" />
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Classes="faint small" VerticalAlignment="Center" IsVisible="{Binding !IsLibraryEmpty}"
                                 Text="{Binding Children.Count, Converter={x:Static views:Icons.CountInParens}}" />
                      <TextBlock Classes="faint small" VerticalAlignment="Center" IsVisible="{Binding IsLibraryEmpty}"
                                 Text="empty: right-click to add a folder" />
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="New folder…" Command="{Binding Tree.NewScriptFolderCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconFolderAdd}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="New script…" Command="{Binding Tree.NewScriptHereCommand}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="Refresh" Command="{Binding Tree.RefreshScriptsCommand}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Open library folder" Command="{Binding Tree.OpenLibraryFolderCommand}" />
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                    </StackPanel>
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:ScriptFolderNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent" ToolTip.Tip="{Binding Path}">
                      <Panel Width="16" Height="16" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" Foreground="{DynamicResource DbxIconFolder}"
                                  IsVisible="{Binding !IsExpanded}" />
                        <PathIcon Data="{StaticResource IconFolderOpen}" Width="15" Height="15" Foreground="{DynamicResource DbxIconFolder}"
                                  IsVisible="{Binding IsExpanded}" />
                      </Panel>
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="New script…" Command="{Binding Tree.NewScriptHereCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconScript}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="New folder…" Command="{Binding Tree.NewScriptFolderCommand}" CommandParameter="{Binding}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconFolderAdd}" /></MenuItem.Icon>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="Rename…" Command="{Binding Tree.RenameScriptNodeCommand}" CommandParameter="{Binding}" InputGesture="F2" />
                          <MenuItem Header="Move to folder…" Command="{Binding Tree.MoveScriptNodeCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Show in Explorer" Command="{Binding Tree.ShowScriptInExplorerCommand}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Classes="danger" Header="Delete" Command="{Binding Tree.DeleteScriptNodeCommand}" CommandParameter="{Binding}" InputGesture="Delete">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconDelete}" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                    </StackPanel>
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:ScriptFileNodeViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
                      <PathIcon Classes="dim" Data="{StaticResource IconScript}" Width="14" Height="14" />
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Open" Command="{Binding Tree.OpenScriptCommand}" CommandParameter="{Binding}" FontWeight="SemiBold" InputGesture="Enter" />
                          <Separator />
                          <MenuItem Header="Rename…" Command="{Binding Tree.RenameScriptNodeCommand}" CommandParameter="{Binding}" InputGesture="F2" />
                          <MenuItem Header="Duplicate" Command="{Binding Tree.DuplicateScriptCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Move to folder…" Command="{Binding Tree.MoveScriptNodeCommand}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="Copy path" Command="{Binding Tree.CopyScriptPathCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Show in Explorer" Command="{Binding Tree.ShowScriptInExplorerCommand}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Classes="danger" Header="Delete" Command="{Binding Tree.DeleteScriptNodeCommand}" CommandParameter="{Binding}" InputGesture="Delete">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconDelete}" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                    </StackPanel>
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:SchemaNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="ER diagram" Click="OnShowDiagram">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconDiagram}" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                      <PathIcon Classes="dim" Data="{StaticResource IconSchema}" Width="14" Height="14" />
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      <TextBlock Classes="faint small" Text="{Binding TableCount, Converter={x:Static views:Icons.CountInParens}}" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeDataTemplate>

                  <!-- Views / Procedures / Functions of a schema -->
                  <TreeDataTemplate DataType="vm:ObjectGroupNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
                      <PathIcon Classes="dim" Width="14" Height="14" Data="{Binding IconKey, Converter={x:Static views:Icons.ByKey}}" />
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Classes="faint small" Text="{Binding CountText}" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:RoutineNodeViewModel">
                    <!-- the signature takes what is left of the row and ends in an ellipsis: a long one never scrolls the navigator sideways -->
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="7" Background="Transparent">
                      <PathIcon Classes="dim" Width="14" Height="14" Data="{Binding IconKey, Converter={x:Static views:Icons.ByKey}}" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Classes="faint small" Text="{Binding Signature}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Signature}"
                                 IsVisible="{Binding Signature, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <Grid.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Open definition" Click="OnOpenDefinition" FontWeight="SemiBold" InputGesture="Enter" />
                          <MenuItem Header="Copy name" Click="OnCopyNodeName" />
                        </ContextMenu>
                      </Grid.ContextMenu>
                    </Grid>
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:MessageNodeViewModel">
                    <TextBlock Classes="faint" Text="{Binding Title}" ToolTip.Tip="{Binding Title}" />
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:PlaceholderNodeViewModel">
                    <TextBlock Classes="faint" Text="{Binding Title}" />
                  </TreeDataTemplate>

                  <TreeDataTemplate DataType="vm:TableNodeViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="7" Background="Transparent">
                      <PathIcon Classes="dim" Width="14" Height="14" Data="{Binding IsView, Converter={x:Static views:Icons.TableOrView}}" />
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Open" Click="OnOpenTableNode" FontWeight="SemiBold" InputGesture="Enter" />
                          <MenuItem Header="Open definition" Click="OnOpenDefinition" IsVisible="{Binding IsView}" />
                          <MenuItem Header="ER diagram (neighbours)" Click="OnShowDiagram" IsVisible="{Binding !IsView}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource IconDiagram}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Copy name" Click="OnCopyNodeName" />
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.DataTemplates>
              </TreeView>
              <!-- where a dragged folder would land (placed by the code-behind, over the tree) -->
              <Border x:Name="FolderDropLine" Height="2" CornerRadius="1" Margin="8,0" VerticalAlignment="Top" IsHitTestVisible="False"
                      IsVisible="False" Background="{DynamicResource DbxAccent}" />

              <!-- nothing configured yet -->
              <StackPanel Classes="empty" Margin="16" IsVisible="{Binding Tree.IsEmpty}">
                <PathIcon Data="{StaticResource IconDatabaseAdd}" />
                <TextBlock Classes="h2" Text="No connections yet" />
                <TextBlock Classes="dim" Text="Add a PostgreSQL, SQL Server, MySQL, MariaDB or SQLite database, or bring your DBeaver connections." />
                <Button Classes="accent" Content="Add a connection" Command="{Binding Tree.AddConnectionCommand}" />
                <Button Classes="ghost" Content="Import from DBeaver" Command="{Binding Tree.ImportFromDBeaverCommand}" />
              </StackPanel>

              <!-- the filter matches nothing -->
              <StackPanel Classes="empty" Margin="16" IsVisible="{Binding Tree.NoMatch}">
                <PathIcon Data="{StaticResource IconSearch}" />
                <TextBlock Classes="h2" Text="No match" />
                <TextBlock Classes="dim" Text="Nothing in the navigator contains that text. Tables are searched in the connections you opened; Ctrl+Shift+P searches every cached table." />
                <Button Content="Clear the filter" Command="{Binding Tree.ClearFilterCommand}" />
              </StackPanel>
            </Panel>
          </DockPanel>
        </Border>

        <!-- visible, grabbable divider -->
        <GridSplitter x:Name="NavSplitter" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Width="5"
                      AutomationProperties.Name="Navigator width" ToolTip.Tip="Drag to resize, double-click to reset" />

        <!-- Editor area: document tabs, or the welcome panel while nothing is open -->
        <Grid Grid.Column="2" Background="{DynamicResource DbxContentBg}">
          <TabControl x:Name="DocTabs" Theme="{StaticResource MainDocTabControl}" ItemContainerTheme="{StaticResource DbxDocTabItem}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}"
                      IsVisible="{Binding !IsEmptyState}">
            <TabControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TabViewModel">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="10,0,4,0" Background="Transparent"
                      ToolTip.Tip="{Binding Title, Converter={x:Static views:Icons.WithoutBullet}}">
                  <Border Grid.Column="0" Width="4" Height="16" CornerRadius="{DynamicResource DbxRadiusXs}" Background="{Binding ChipColor}" Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                  <PathIcon Grid.Column="1" Classes="dim" Width="13" Height="13" Margin="0,0,6,0"
                            Data="{Binding IconKey, Converter={x:Static views:Icons.ByKey}}" />
                  <TextBlock Grid.Column="2" Text="{Binding Title, Converter={x:Static views:Icons.WithoutBullet}}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Ellipse Grid.Column="3" Classes="dirty" Width="8" Height="8" Margin="7,1,0,0" Fill="{DynamicResource DbxAccent}"
                           VerticalAlignment="Center" IsVisible="{Binding HasUnsavedWork}" ToolTip.Tip="Unsaved changes" />
                  <PathIcon Grid.Column="4" Data="{StaticResource IconLock}" Width="11" Height="11" Margin="7,0,0,0"
                            Foreground="{DynamicResource DbxWarn}" VerticalAlignment="Center"
                            IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="{Binding Badge}" />
                  <views:EnvironmentBadge Grid.Column="5" Environment="{Binding ConnectionEnvironment}" Margin="7,0,0,0" />
                  <Button Grid.Column="6" Classes="close" Theme="{StaticResource DbxToolButton}" Tag="{StaticResource IconClose}"
                          MinWidth="22" MinHeight="22" Padding="4" Margin="6,0,0,0"
                          Command="{Binding $parent[TabControl].((vm:MainViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}" AutomationProperties.Name="Close tab" ToolTip.Tip="Close (Ctrl+W)" />
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Close" InputGesture="Ctrl+W" Command="{Binding $parent[TabControl].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                CommandParameter="{Binding}" />
                      <MenuItem Header="Close other tabs" Command="{Binding $parent[TabControl].((vm:MainViewModel)DataContext).CloseOtherTabsCommand}"
                                CommandParameter="{Binding}" />
                      <MenuItem Header="Close tabs to the right" Command="{Binding $parent[TabControl].((vm:MainViewModel)DataContext).CloseTabsToTheRightCommand}"
                                CommandParameter="{Binding}" />
                      <MenuItem Header="Close all tabs" Command="{Binding $parent[TabControl].((vm:MainViewModel)DataContext).CloseAllTabsCommand}" />
                      <Separator />
                      <MenuItem Header="Reopen closed tab" InputGesture="Ctrl+Shift+T"
                                Command="{Binding $parent[TabControl].((vm:MainViewModel)DataContext).ReopenClosedTabCommand}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                </Grid>
              </DataTemplate>
            </TabControl.ItemTemplate>
          </TabControl>

          <!-- Welcome panel (no tab open) -->
          <ScrollViewer IsVisible="{Binding IsEmptyState}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="520" Margin="24,56,24,32" Spacing="24" HorizontalAlignment="Center">
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource IconDatabase}" Width="36" Height="36" Foreground="{DynamicResource DbxAccent}"
                          HorizontalAlignment="Center" />
                <TextBlock Classes="h1" Text="dbExplorer" HorizontalAlignment="Center" Margin="0,6,0,0" />
                <TextBlock Classes="dim" Text="{Binding WelcomeHint}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="8">
                <Button Classes="card" Command="{Binding ShowTablePickerCommand}" IsVisible="{Binding HasConnections}"
                        IsEnabled="{Binding HasTarget}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding WelcomeHint}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Classes="dim" Data="{StaticResource IconTable}" Width="20" Height="20" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Go to a table" FontWeight="SemiBold" />
                      <TextBlock Classes="dim small" Text="Search tables, views, routines and columns" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl+T" /></Border>
                  </Grid>
                </Button>
                <Button Classes="card" Command="{Binding NewScriptTabCommand}" IsVisible="{Binding HasConnections}"
                        IsEnabled="{Binding HasTarget}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding WelcomeHint}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Classes="dim" Data="{StaticResource IconScript}" Width="20" Height="20" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="New SQL script" FontWeight="SemiBold" />
                      <TextBlock Classes="dim small" Text="An editor on the selected connection" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl+N" /></Border>
                  </Grid>
                </Button>
                <Button Classes="card" Command="{Binding Tree.AddConnectionCommand}">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Classes="dim" Data="{StaticResource IconDatabaseAdd}" Width="20" Height="20" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Add a connection" FontWeight="SemiBold" />
                      <TextBlock Classes="dim small" Text="PostgreSQL, SQL Server, MySQL, MariaDB or a SQLite file" />
                    </StackPanel>
                  </Grid>
                </Button>
                <Button Classes="card" Command="{Binding Tree.ImportFromDBeaverCommand}">
                  <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Classes="dim" Data="{StaticResource IconImport}" Width="20" Height="20" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Import from DBeaver" FontWeight="SemiBold" />
                      <TextBlock Classes="dim small" Text="Folders, connections and credentials" />
                    </StackPanel>
                  </Grid>
                </Button>
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding HasRecentTabs}">
                <TextBlock Classes="section" Text="Recently closed" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding RecentTabs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MainViewModel+RecentTab">
                      <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ReopenRecentCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Reopen">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <PathIcon Classes="dim" Data="{Binding Icon, Converter={x:Static views:Icons.ByKey}}" Width="14" Height="14" />
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Border BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section" Text="Shortcuts" Margin="0" />
                  <ItemsControl ItemsSource="{x:Static views:ShortcutCatalog.Highlights}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="views:ShortcutItem">
                        <Grid ColumnDefinitions="150,*" Margin="0,3">
                          <Border Classes="kbd" HorizontalAlignment="Left"><TextBlock Text="{Binding Keys}" /></Border>
                          <TextBlock Grid.Column="1" Classes="dim" Text="{Binding Text}" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Classes="ghost link" Padding="6,4" Margin="-6,0,0,0" HorizontalAlignment="Left" Command="{Binding ShowShortcutsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="All keyboard shortcuts" />
                      <Border Classes="kbd"><TextBlock Text="F1" /></Border>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- Quick-open overlay: created on demand, nothing when closed -->
    <ContentControl Content="{Binding QuickOpen}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:QuickOpenViewModel">
          <views:QuickOpenOverlay />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- Search in scripts and data (Ctrl+Alt+F): created on demand -->
    <ContentControl Content="{Binding SearchOverlay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:SearchViewModel">
          <views:SearchOverlay />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- Command palette (Ctrl+Shift+K): created on demand -->
    <ContentControl Content="{Binding CommandPalette}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:CommandPaletteViewModel">
          <views:CommandPaletteOverlay />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <!-- Keyboard shortcuts card (F1) -->
    <Border x:Name="ShortcutsScrim" Background="{DynamicResource DbxScrim}" IsVisible="{Binding IsShortcutsVisible}"
            PointerPressed="OnShortcutsScrimPressed">
      <Border x:Name="ShortcutsCard" Classes="card" Padding="0" Width="620" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center"
              BoxShadow="{DynamicResource DbxCardShadow}" PointerPressed="OnShortcutsCardPressed">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="20,14,12,12" BorderBrush="{DynamicResource DbxBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="Keyboard shortcuts" VerticalAlignment="Center" />
              <Button Grid.Column="1" Theme="{StaticResource DbxToolButton}" Classes="close" Tag="{StaticResource IconClose}" MinWidth="22" MinHeight="22" Padding="4"
                      Command="{Binding HideShortcutsCommand}" AutomationProperties.Name="Close" ToolTip.Tip="Close (Esc)" />
            </Grid>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="20,8,20,16">
            <ItemsControl ItemsSource="{x:Static views:ShortcutCatalog.Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:ShortcutSection">
                  <StackPanel Margin="0,10,0,4" Spacing="2">
                    <TextBlock Classes="section" Text="{Binding Title}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:ShortcutItem">
                          <Grid ColumnDefinitions="190,*" Margin="0,3">
                            <Border Classes="kbd" HorizontalAlignment="Left"><TextBlock Text="{Binding Keys}" /></Border>
                            <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</Window>
