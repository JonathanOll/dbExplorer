<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>DbExplorer</AssemblyName>
    <RootNamespace>DbExplorer.App</RootNamespace>
    <TieredPGO>false</TieredPGO>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <!-- The UI is English only: do not ship (and Defender-scan) 12 satellite resource folders of the dependencies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- GitHub repo (owner/name) the auto-update checks; baked into the exe as assembly metadata. CI overrides it. -->
    <GitHubRepository Condition="'$(GitHubRepository)' == ''">JonathanOll/dbExplorer</GitHubRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GitHubRepository" Value="$(GitHubRepository)" />
  </ItemGroup>

  <!-- Startup speed (see README, Startup performance). Only active when publishing for a runtime (publish.ps1 passes -r win-x64):
       ReadyToRun of the app AND its dependencies as ONE composite image, so Avalonia's generic instantiations over its own
       types are precompiled instead of JIT-ed at launch (about 2600 -> 1200 JIT-ed methods). Never enable trimming here:
       Avalonia bindings and the DB providers rely on reflection. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UiShots" />
    <InternalsVisibleTo Include="DbExplorer.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Relay script of the auto-update, written to a temp dir at apply time (see Updates\UpdateApplier). -->
    <EmbeddedResource Include="Updates\ApplyUpdate.ps1" LogicalName="DbExplorer.App.Updates.ApplyUpdate.ps1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbExplorer.Core\DbExplorer.Core.csproj" />
  </ItemGroup>

</Project>

