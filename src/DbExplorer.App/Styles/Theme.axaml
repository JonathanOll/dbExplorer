    <ResourceDictionary x:Key="Dark">
      <!-- Regions: window, navigator, panel headers and the tab strip are ONE chrome tone; content, toolbars and inputs are lighter -->
      <SolidColorBrush x:Key="DbxWindowBg" Color="#181A1F" />
      <SolidColorBrush x:Key="DbxNavBg" Color="#181A1F" />
      <SolidColorBrush x:Key="DbxPanelHeaderBg" Color="#181A1F" />
      <SolidColorBrush x:Key="DbxTabStripBg" Color="#181A1F" />
      <SolidColorBrush x:Key="DbxContentBg" Color="#1F2228" />
      <SolidColorBrush x:Key="DbxToolbarBg" Color="#1F2228" />
      <SolidColorBrush x:Key="DbxInputBg" Color="#1A1D22" />
      <SolidColorBrush x:Key="DbxSurface" Color="#262A32" />
      <SolidColorBrush x:Key="DbxScrim" Color="#99000000" />
      <!-- Lines -->
      <SolidColorBrush x:Key="DbxBorder" Color="#343841" />
      <SolidColorBrush x:Key="DbxBorderSubtle" Color="#2A2E35" />
      <SolidColorBrush x:Key="DbxBorderStrong" Color="#6D7685" />
      <SolidColorBrush x:Key="DbxSplitter" Color="#181A1F" />
      <!-- Text -->
      <SolidColorBrush x:Key="DbxText" Color="#E6E9EE" />
      <SolidColorBrush x:Key="DbxTextDim" Color="#A4ACB9" />
      <SolidColorBrush x:Key="DbxTextFaint" Color="#949DAB" />
      <!-- Accent (the only decorative colour) and interaction states -->
      <SolidColorBrush x:Key="DbxAccent" Color="#7C97F5" />
      <SolidColorBrush x:Key="DbxAccentStrong" Color="#9BB0F8" />
      <SolidColorBrush x:Key="DbxAccentButtonBg" Color="#4565E0" />
      <SolidColorBrush x:Key="DbxAccentButtonHover" Color="#4C6BE3" />
      <SolidColorBrush x:Key="DbxOnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DbxAccentSoft" Color="#29335E" />
      <SolidColorBrush x:Key="DbxAccentSoftHover" Color="#313D70" />
      <SolidColorBrush x:Key="DbxHover" Color="#2B2F37" />
      <SolidColorBrush x:Key="DbxPressed" Color="#343942" />
      <SolidColorBrush x:Key="DbxButtonBg" Color="#2A2E36" />
      <SolidColorBrush x:Key="DbxLink" Color="#8AA3F7" />
      <SolidColorBrush x:Key="DbxFocusRing" Color="#8CA3F7" />
      <!-- Data grid -->
      <SolidColorBrush x:Key="DbxGridHeaderBg" Color="#252930" />
      <SolidColorBrush x:Key="DbxGridFilterBg" Color="#1D2025" />
      <SolidColorBrush x:Key="DbxGridLine" Color="#343942" />
      <SolidColorBrush x:Key="DbxGridZebra" Color="#2A2E37" />
      <SolidColorBrush x:Key="DbxColumnFlash" Color="#6E5B12" />
      <SolidColorBrush x:Key="DbxColumnFlashHeader" Color="#9A7F10" />
