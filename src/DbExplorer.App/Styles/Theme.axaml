      <SolidColorBrush x:Key="DbxRowSelected" Color="#34478C" />
      <SolidColorBrush x:Key="DbxRowSelectedInactive" Color="#2C3558" />
      <!-- Grid cell states (translucent: they read over zebra and selection) and editor -->
      <SolidColorBrush x:Key="DbxCellEdited" Color="#55F2B600" />
      <SolidColorBrush x:Key="DbxCellNew" Color="#5538C26A" />
      <SolidColorBrush x:Key="DbxCellDeleted" Color="#66E5534B" />
      <SolidColorBrush x:Key="DbxCellError" Color="#F2766E" />
