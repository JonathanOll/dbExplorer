<!--
  Design tokens of dbExplorer (see docs/ui/README.md). Every colour of the UI comes from here: views and styles refer to the
  Dbx* brushes (DynamicResource, so a live Windows light/dark switch repaints them), never to a hex value.
  One "Light" and one "Dark" dictionary with the same keys. The last block of each re-points the Fluent theme's own control
  brushes (buttons, inputs, combo box, check box, tree, menus, scroll bar, data grid) to the tokens, so stock controls follow
  the palette without re-templating them.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Sizes, fonts, shapes: theme independent ===== -->
  <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  <x:Double x:Key="DbxFontSize">13</x:Double>
  <x:Double x:Key="DbxSmallFontSize">11.5</x:Double>
  <x:Double x:Key="DbxGridFontSize">12.5</x:Double>
  <x:Double x:Key="DbxH1FontSize">20</x:Double>
  <x:Double x:Key="DbxH2FontSize">15</x:Double>         <!-- also dialog titles (TextBlock.h2) -->
  <x:Double x:Key="DbxBadgeFontSize">11.5</x:Double>    <!-- text in Border.badge -->
  <x:Double x:Key="DbxMonoFontSize">12</x:Double>       <!-- code, identifiers and SQL snippets in DbxMonoFont outside the editor -->
  <x:Double x:Key="DbxRowHeight">28</x:Double>            <!-- tree rows (pitch) -->
  <x:Double x:Key="DbxGridRowHeight">28</x:Double>        <!-- data grid rows -->
  <x:Double x:Key="DbxToolbarHeight">40</x:Double>
  <x:Double x:Key="DbxTabHeight">38</x:Double>            <!-- document tab strip -->
  <x:Double x:Key="DbxSubTabHeight">36</x:Double>
  <x:Double x:Key="DbxControlHeight">32</x:Double>        <!-- text boxes, combo boxes -->
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="DbxRadius">6</CornerRadius>
  <CornerRadius x:Key="DbxRadiusXs">2</CornerRadius>     <!-- tiny marks: bars, swatches, indicators -->
  <CornerRadius x:Key="DbxRadiusSm">4</CornerRadius>
  <CornerRadius x:Key="DbxRadiusMd">8</CornerRadius>     <!-- Border.surface -->
  <CornerRadius x:Key="DbxCardRadius">10</CornerRadius>
  <CornerRadius x:Key="DbxPillRadius">99</CornerRadius>
  <Thickness x:Key="ButtonPadding">14,5,14,6</Thickness>
  <Thickness x:Key="ListBoxItemPadding">10,6,10,6</Thickness>
  <Thickness x:Key="ComboBoxItemThemePadding">10,6,10,6</Thickness>
  <Thickness x:Key="ComboBoxDropdownContentMargin">4,4,4,4</Thickness>
  <Thickness x:Key="MenuFlyoutScrollerMargin">4,4,4,4</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">10,6,10,6</Thickness>
  <Thickness x:Key="MenuFlyoutSeparatorThemePadding">8,4,8,4</Thickness>
  <Thickness x:Key="ToolTipBorderThemePadding">9,5,9,6</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
  <x:Double x:Key="ToolTipContentThemeFontSize">12</x:Double>
  <x:Double x:Key="ScrollBarSize">12</x:Double>
  <x:Double x:Key="TreeViewItemMinHeight">26</x:Double>
  <x:Double x:Key="TreeViewItemIndent">16</x:Double>
  <x:Double x:Key="TreeViewItemExpandCollapseChevronSize">10</x:Double>
  <Thickness x:Key="TreeViewItemExpandCollapseChevronMargin">8,0,4,0</Thickness>
  <!-- one family on purpose: a FontFamily element takes a comma list as a single family name -->
  <FontFamily x:Key="DbxMonoFont">Consolas</FontFamily>
  <!-- Configurable (Settings > Editor / Appearance): AppearanceApplier replaces these at run time; do not hard-code the values in a view -->
  <FontFamily x:Key="DbxEditorFont">Consolas</FontFamily>
  <x:Double x:Key="DbxEditorFontSize">13</x:Double>
  <ScaleTransform x:Key="DbxUiScale" ScaleX="1" ScaleY="1" />
  <BoxShadows x:Key="DbxCardShadow">0 12 32 0 #40000000</BoxShadows>

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <!-- Regions: window, navigator, panel headers and the tab strip are ONE chrome tone; content, toolbars and inputs are lighter -->
      <SolidColorBrush x:Key="DbxWindowBg" Color="#F3F5F8" />
      <SolidColorBrush x:Key="DbxNavBg" Color="#F3F5F8" />
      <SolidColorBrush x:Key="DbxPanelHeaderBg" Color="#F3F5F8" />
      <SolidColorBrush x:Key="DbxTabStripBg" Color="#F3F5F8" />
      <SolidColorBrush x:Key="DbxContentBg" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DbxToolbarBg" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DbxInputBg" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DbxSurface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DbxScrim" Color="#4D0F1626" />
      <!-- Lines -->
      <SolidColorBrush x:Key="DbxBorder" Color="#D3D8E0" />
      <SolidColorBrush x:Key="DbxBorderSubtle" Color="#E5E8EE" />
      <SolidColorBrush x:Key="DbxBorderStrong" Color="#8992A1" />
      <SolidColorBrush x:Key="DbxSplitter" Color="#F3F5F8" />
      <!-- Text -->
      <SolidColorBrush x:Key="DbxText" Color="#1B222C" />
      <SolidColorBrush x:Key="DbxTextDim" Color="#556070" />
      <SolidColorBrush x:Key="DbxTextFaint" Color="#5E6877" />
      <!-- Accent (the only decorative colour) and interaction states -->
      <SolidColorBrush x:Key="DbxAccent" Color="#3E63DD" />
      <SolidColorBrush x:Key="DbxAccentStrong" Color="#3354C5" />
      <SolidColorBrush x:Key="DbxAccentButtonBg" Color="#3E63DD" />
      <SolidColorBrush x:Key="DbxAccentButtonHover" Color="#3556CC" />
      <SolidColorBrush x:Key="DbxOnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DbxAccentSoft" Color="#E4EAFD" />
      <SolidColorBrush x:Key="DbxAccentSoftHover" Color="#D8E1FB" />
      <SolidColorBrush x:Key="DbxHover" Color="#E9ECF1" />
      <SolidColorBrush x:Key="DbxPressed" Color="#DEE2E9" />
      <SolidColorBrush x:Key="DbxButtonBg" Color="#FCFCFD" />
      <SolidColorBrush x:Key="DbxLink" Color="#3556C4" />
      <SolidColorBrush x:Key="DbxFocusRing" Color="#3E63DD" />
      <!-- Data grid -->
      <SolidColorBrush x:Key="DbxGridHeaderBg" Color="#F5F7FA" />
      <SolidColorBrush x:Key="DbxGridFilterBg" Color="#FBFCFD" />
      <SolidColorBrush x:Key="DbxGridLine" Color="#E1E5EC" />
      <SolidColorBrush x:Key="DbxGridZebra" Color="#F2F5FA" />
      <SolidColorBrush x:Key="DbxColumnFlash" Color="#FFE27A" />
      <SolidColorBrush x:Key="DbxColumnFlashHeader" Color="#FFC933" />
      <SolidColorBrush x:Key="DbxRowHover" Color="#E4ECFA" />
      <SolidColorBrush x:Key="DbxRowSelected" Color="#CFDCFB" />
      <SolidColorBrush x:Key="DbxRowSelectedInactive" Color="#E0E7F5" />
      <!-- Grid cell states (translucent: they read over zebra and selection) and editor -->
      <SolidColorBrush x:Key="DbxCellEdited" Color="#55F2B600" />
      <SolidColorBrush x:Key="DbxCellNew" Color="#4429A329" />
      <SolidColorBrush x:Key="DbxCellDeleted" Color="#44D32F2F" />
      <SolidColorBrush x:Key="DbxCellError" Color="#C8372D" />
      <SolidColorBrush x:Key="DbxEditorSelection" Color="#C9D7FB" />
      <SolidColorBrush x:Key="DbxEditorCurrentLine" Color="#F2F5FD" />
      <SolidColorBrush x:Key="DbxEditorGutterText" Color="#8892A2" />
      <SolidColorBrush x:Key="DbxEditorGutterBorder" Color="#E5E8EE" />
      <!-- SQL syntax (read by ScriptTabView for the AvaloniaEdit highlighting) -->
      <SolidColorBrush x:Key="DbxSyntaxKeyword" Color="#1F5FBF" />
      <SolidColorBrush x:Key="DbxSyntaxComment" Color="#4F7F2D" />
      <SolidColorBrush x:Key="DbxSyntaxString" Color="#A8381C" />
      <!-- Status: icon colour + banner bg / border / text -->
      <SolidColorBrush x:Key="DbxError" Color="#C8372D" />
      <SolidColorBrush x:Key="DbxErrorBg" Color="#FDEDEB" />
      <SolidColorBrush x:Key="DbxErrorBorder" Color="#F3C2BD" />
      <SolidColorBrush x:Key="DbxErrorText" Color="#8F2A22" />
      <SolidColorBrush x:Key="DbxWarn" Color="#B45F06" />
      <SolidColorBrush x:Key="DbxWarnBg" Color="#FFF5DC" />
      <SolidColorBrush x:Key="DbxWarnBorder" Color="#EFD595" />
      <SolidColorBrush x:Key="DbxWarnText" Color="#6B4200" />
      <SolidColorBrush x:Key="DbxInfo" Color="#3E63DD" />
      <SolidColorBrush x:Key="DbxInfoBg" Color="#EAEFFD" />
      <SolidColorBrush x:Key="DbxInfoBorder" Color="#C5D2F8" />
      <SolidColorBrush x:Key="DbxInfoText" Color="#243B8F" />
      <SolidColorBrush x:Key="DbxSuccess" Color="#1A8044" />
      <SolidColorBrush x:Key="DbxSuccessBg" Color="#E8F6EC" />
      <SolidColorBrush x:Key="DbxSuccessBorder" Color="#BCE0C9" />
      <SolidColorBrush x:Key="DbxSuccessText" Color="#165F36" />
      <!-- Icons: monochrome; only the semantic colours above are coloured -->
      <SolidColorBrush x:Key="DbxIcon" Color="#5F6B7B" />
      <SolidColorBrush x:Key="DbxIconFolder" Color="#A98B57" />
      <SolidColorBrush x:Key="DbxIconTable" Color="#5E7391" />
      <SolidColorBrush x:Key="DbxIconView" Color="#7F70AE" />
      <SolidColorBrush x:Key="DbxIconKey" Color="#B08718" />
      <SolidColorBrush x:Key="DbxRun" Color="#1A8044" />
      <SolidColorBrush x:Key="DbxStop" Color="#C8372D" />
      <SolidColorBrush x:Key="DbxDanger" Color="#C8372D" />
      <SolidColorBrush x:Key="DbxDangerHover" Color="#B32F26" />
      <!-- Scrollbar thumb -->
      <SolidColorBrush x:Key="DbxThumb" Color="#C2C8D2" />
      <SolidColorBrush x:Key="DbxThumbHover" Color="#98A1AF" />
      <SolidColorBrush x:Key="DbxThumbPressed" Color="#76808F" />
      <BoxShadows x:Key="DbxFocusGlow">0 0 0 3 #4D3E63DD</BoxShadows>
      <BoxShadows x:Key="DbxFocusGlowError">0 0 0 3 #4DC8372D</BoxShadows>
      <BoxShadows x:Key="DbxFocusInset">inset 0 0 0 2 #3E63DD</BoxShadows>
      <Color x:Key="ScrollBarThumbBackgroundColor">#98A1AF</Color>
      <Color x:Key="ScrollBarPanningThumbBackgroundColor">#C2C8D2</Color>
      <!-- Fluent control brushes re-pointed to the tokens: stock controls follow the palette -->
      <SolidColorBrush x:Key="TreeViewItemBackground" Color="Transparent" />
      <StaticResource x:Key="ButtonBackground" ResourceKey="DbxButtonBg" />
      <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DbxHover" />
      <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DbxPressed" />
      <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="DbxButtonBg" />
