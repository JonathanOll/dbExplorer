      <SolidColorBrush x:Key="DbxSyntaxKeyword" Color="#6CB0F5" />
      <SolidColorBrush x:Key="DbxSyntaxComment" Color="#7FA66A" />
      <SolidColorBrush x:Key="DbxSyntaxString" Color="#E39A7A" />
      <!-- Status: icon colour + banner bg / border / text -->
      <SolidColorBrush x:Key="DbxError" Color="#F2766E" />
