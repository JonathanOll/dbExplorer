      <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="DbxOnAccent" />
      <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="DbxTextFaint" />
      <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="DbxAccentButtonBg" />
      <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="DbxAccentButtonHover" />
      <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="DbxAccentStrong" />
      <StaticResource x:Key="AccentButtonBorderBrushDisabled" ResourceKey="DbxHover" />
      <StaticResource x:Key="ToggleButtonBackground" ResourceKey="DbxButtonBg" />
      <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="DbxHover" />
      <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="DbxPressed" />
      <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="DbxAccentSoft" />
      <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="DbxAccentSoftHover" />
      <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="DbxAccentSoftHover" />
      <StaticResource x:Key="ToggleButtonForeground" ResourceKey="DbxText" />
      <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="DbxText" />
      <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="DbxText" />
      <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="DbxAccentStrong" />
      <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="DbxAccentStrong" />
      <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="DbxAccentStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="DbxBorder" />
      <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="DbxBorderStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="DbxBorderStrong" />
      <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="DbxAccent" />
      <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="DbxAccent" />
